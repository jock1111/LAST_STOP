      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid:Give(task)
	table.insert(self._tasks, task)
	return task
end

function Maid:Clean()
	for _, task in ipairs(self._tasks) do
		local kind = typeof(task)
		if kind == "RBXScriptConnection" then
			task:Disconnect()
		elseif kind == "Instance" then
			task:Destroy()
		elseif type(task) == "function" then
			task()
		elseif type(task) == "table" and task.Destroy then
			task:Destroy()
		end
	end
	table.clear(self._tasks)
end

function Maid:Destroy()
	self:Clean()
end

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(maxCount, windowSeconds)
	return setmetatable({ maxCount = maxCount, windowSeconds = windowSeconds, buckets = {} }, RateLimiter)
end

function RateLimiter:Allow(key)
	local now = os.clock()
	local bucket = self.buckets[key]
	if not bucket or now - bucket.started >= self.windowSeconds then
		self.buckets[key] = { started = now, count = 1 }
		return true
	end
	if bucket.count >= self.maxCount then
		return false
	end
	bucket.count += 1
	return true
end

function RateLimiter:Forget(key)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">SubwayCycle</string>
            <string name="Source"><![CDATA[-- Pure timing rules for the abandoned subway train pass. Server-only logic reads
-- these; the client never decides whether a train is passing or who is hit.
local SubwayCycle = {}

SubwayCycle.Period = 16
SubwayCycle.WarningStart = 8
SubwayCycle.ActiveStart = 12
SubwayCycle.Damage = 25

-- Returns "Safe", "Warning" or "Active" for an elapsed time and a per-run offset.
function SubwayCycle.Phase(elapsed, offset)
	local cycle = (elapsed + offset) % SubwayCycle.Period
	if cycle > SubwayCycle.ActiveStart then
		return "Active", cycle
	elseif cycle > SubwayCycle.WarningStart then
		return "Warning", cycle
	end
	return "Safe", cycle
end

-- Train Z position along the track while Active; parked far away otherwise.
function SubwayCycle.TrainZ(cycle, phase)
	if phase ~= "Active" then
		return -200
	end
	return -86 + (cycle - SubwayCycle.ActiveStart) * 54
end

-- A player is hit when inside the track lane and close to the train's Z.
function SubwayCycle.Exposed(localPosition, trainZ, previousZ)
	local startZ = previousZ or trainZ
	return math.abs(localPosition.X) < 6.5
		and localPosition.Y > -6 and localPosition.Y < 8
		and localPosition.Z > math.min(startZ, trainZ) - 22
		and localPosition.Z < math.max(startZ, trainZ) + 22
end

-- Random next patrol waypoint that is never the one just reached.
function SubwayCycle.PickPatrolIndex(random, count, current)
	if count <= 1 then return 1 end
	local index = random:NextInteger(1, count - 1)
	if index >= current then index += 1 end
	return index
end

return SubwayCycle
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="23">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- LAST STOP Milestone A server bootstrap. Place as a Script in ServerScriptService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local RemoteNames = require(ReplicatedStorage.Shared.Config.RemoteNames)
local RateLimiter = require(ReplicatedStorage.Shared.Util.RateLimiter)
local ProfileService = require(script.Parent.Services.ProfileService)
local EconomyService = require(script.Parent.Services.EconomyService)
local FloorService = require(script.Parent.Services.FloorService)
local PbrMaterialService = require(script.Parent.Services.PbrMaterialService)
local EnemyService = require(script.Parent.Services.EnemyService)
local InventoryService = require(script.Parent.Services.InventoryService)
local MatchmakingService = require(script.Parent.Services.MatchmakingService)
local ExpeditionService = require(script.Parent.Services.ExpeditionService)

local function ensureRemotes()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	local remotes = {}
	for key, name in pairs(RemoteNames) do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		assert(remote:IsA("RemoteEvent"), "Remote " .. name .. " must be a RemoteEvent")
		remotes[key] = remote
	end
	return remotes
end

local remotes = ensureRemotes()
local profiles = ProfileService.new(GameConfig)
local economy = EconomyService.new(profiles, GameConfig)
local floors = FloorService.new()
local enemyService = EnemyService.new()
local inventory = InventoryService.new()
local lobby = floors:BuildWorld()
PbrMaterialService:Apply(lobby.Model)
enemyService:Start()

Lighting.Brightness = 2
Lighting.ClockTime = 0
Lighting.Ambient = Color3.fromRGB(96, 108, 114)
Lighting.OutdoorAmbient = Color3.fromRGB(20, 25, 31)
Lighting.FogColor = Color3.fromRGB(34, 43, 51)
Lighting.FogEnd = 350
Lighting.GlobalShadows = true
-- LightingStyle is saved in default.project.json (Studio-only capability).
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.6

local function effect(className, name, properties)
	local instance = Lighting:FindFirstChild(name)
	if not instance then
		instance = Instance.new(className)
		instance.Name = name
		instance.Parent = Lighting
	end
	for property, value in pairs(properties) do
		instance[property] = value
	end
	return instance
end

effect("Atmosphere", "LastStopAtmosphere", {
	Density = 0.12,
	Offset = 0.15,
	Color = Color3.fromRGB(145, 169, 182),
	Decay = Color3.fromRGB(38, 55, 65),
	Glare = 0,
	Haze = 1.15,
})
effect("ColorCorrectionEffect", "LastStopGrade", {
	Brightness = -0.03,
	Contrast = 0.12,
	Saturation = -0.08,
	TintColor = Color3.fromRGB(214, 235, 242),
})
effect("BloomEffect", "LastStopBloom", {
	Intensity = 0.18,
	Size = 28,
	Threshold = 1.6,
})

local limiter = RateLimiter.new(GameConfig.RemoteRateLimit.Count, GameConfig.RemoteRateLimit.WindowSeconds)
local currentExpedition = nil
local matchmaking

local function toast(player, message)
	remotes.Toast:FireClient(player, message)
end

local function moveToLobby(player)
	player.RespawnLocation = lobby.SpawnLocation
	task.spawn(function()
		local character = player.Character or player.CharacterAdded:Wait()
		local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
		if root then
			task.wait(.2) -- Allow the engine to finish initial spawn placement.
			if not player.Parent then return end
			character:PivotTo(lobby.LobbySpawn)
		end
	end)
end

local function canQueue(player)
	return profiles:Get(player) ~= nil and (not currentExpedition or not currentExpedition:IsRunning())
end

matchmaking = MatchmakingService.new(GameConfig, canQueue, function(group, finished)
	local expedition
	expedition = ExpeditionService.new(
		GameConfig,
		floors,
		enemyService,
		economy,
		profiles,
		inventory,
		remotes,
		function(reason)
			if currentExpedition == expedition then
				currentExpedition = nil
			end
			finished()
			print("[LAST STOP] Expedition ended:", reason)
		end
	)
	currentExpedition = expedition
	expedition:Start(group)
end, toast)

require(script.Parent.Services.MovementService).Start(remotes.RequestSprint, function(player)
    return currentExpedition and (currentExpedition.state == "Floor" or currentExpedition.state == "Escape") and currentExpedition.active[player] == true
end)
local function remotelyAllowed(remoteName, player)
	if not limiter:Allow(remoteName .. ":" .. player.UserId) then
		toast(player, "Too many requests. Please wait a moment.")
		return false
	end
	return true
end

remotes.RequestQueue.OnServerEvent:Connect(function(player, ...)
	if select("#", ...) ~= 0 or not remotelyAllowed("Queue", player) then
		return
	end
	local ok, message = matchmaking:RequestJoin(player)
	toast(player, message)
end)
remotes.RequestState.OnServerEvent:Connect(function(player, ...)
	if select("#", ...) ~= 0 or not remotelyAllowed("State", player) then return end
	if currentExpedition and currentExpedition:SyncState(player) then return end
	local snapshot = player:GetAttribute("LastStopSnapshot")
	if snapshot then
		local ok, data = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), snapshot)
		if ok and data.state == "Results" then remotes.StateChanged:FireClient(player, data); return end
	end
	remotes.StateChanged:FireClient(player, {
		state = "Lobby", floorName = "Terminus Concourse", progress = 0, unbanked = 0,
		banked = economy:GetBankedCoins(player), objective = "Board an expedition. Bring your team home.",
	})
end)

remotes.RequestDecision.OnServerEvent:Connect(function(player, decision, ...)
	if select("#", ...) ~= 0 or type(decision) ~= "string" or #decision > 10 or not remotelyAllowed("Decision", player) then
		return
	end
	if not currentExpedition then
		return
	end
	local ok, message = currentExpedition:RequestDecision(player, decision)
	if not ok then
		toast(player, message)
	end
end)

remotes.RequestMedkit.OnServerEvent:Connect(function(player, ...)
	if select("#", ...) ~= 0 or not remotelyAllowed("Medkit", player) then
		return
	end
	if currentExpedition then
		local ok, message = currentExpedition:RequestMedkit(player)
		toast(player, message)
	end
end)

lobby.QueuePrompt.Triggered:Connect(function(player)
	local ok, message = matchmaking:RequestJoin(player)
	toast(player, message)
end)

local function onPlayerAdded(player)
	profiles:Load(player)
	player:SetAttribute("LastStopProfileLoaded", true)
	moveToLobby(player)
	toast(player, "Welcome to LAST STOP. Queue at the terminal or press PLAY.")
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	matchmaking:Remove(player)
	if currentExpedition then
		currentExpedition:OnPlayerRemoving(player)
	end
	limiter:Forget("Queue:" .. player.UserId)
	limiter:Forget("State:" .. player.UserId)
	limiter:Forget("Decision:" .. player.UserId)
	limiter:Forget("Medkit:" .. player.UserId)
	profiles:Release(player)
end)

task.spawn(function()
	while task.wait(GameConfig.AutosaveSeconds) do
		profiles:SaveAll()
	end
end)

game:BindToClose(function()
	if currentExpedition then
		currentExpedition:Destroy()
	end
	profiles:SaveAll()
end)

matchmaking:Start()
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[local EconomyConfig = require(game:GetService("ReplicatedStorage").Shared.Config.EconomyConfig)

local EconomyService = {}
EconomyService.__index = EconomyService

function EconomyService.new(profileService, gameConfig)
	return setmetatable({ _profiles = profileService, _gameConfig = gameConfig }, EconomyService)
end

function EconomyService:CalculateFloorReward(depth, objectiveProgress)
	local multiplier = math.min(
		1 + math.max(0, depth - 1) * EconomyConfig.DepthMultiplierStep,
		EconomyConfig.MaxDepthMultiplier
	)
	local gross = EconomyConfig.BaseFloorCoins + EconomyConfig.TeamCompletionBonus
		+ EconomyConfig.ObjectiveBonus + objectiveProgress * EconomyConfig.XPPerObjectiveStep
	return math.floor(gross * multiplier), math.floor(EconomyConfig.XPPerFloor * multiplier)
end

function EconomyService:Bank(player, unbanked, pendingXP, depth)
	if unbanked <= 0 then
		return 0
	end
	local granted = 0
	self._profiles:Mutate(player, function(profile)
		profile.Coins += unbanked
		profile.XP += math.max(0, pendingXP or 0)
		profile.Level = math.max(1, math.floor(profile.XP / 100) + 1)
		profile.Stats.Escapes += 1
		profile.Stats.BestDepth = math.max(profile.Stats.BestDepth or 0, depth)
		if not profile.Stats.FirstEscapeClaimed then
			profile.Stats.FirstEscapeClaimed = true
			profile.Coins += self._gameConfig.FirstEscapeBonus
			granted = unbanked + self._gameConfig.FirstEscapeBonus
		else
			granted = unbanked
		end
	end)
	self._profiles:Save(player)
	return granted
end

function EconomyService:GetBankedCoins(player)
	local profile = self._profiles:Get(player)
	return profile and profile.Coins or 0
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local PhysicsService = game:GetService("PhysicsService")
local SubwayCycle = require(game:GetService("ReplicatedStorage").Shared.Util.SubwayCycle)
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.Config.GameConfig)
local EnemyService = {}
EnemyService.__index = EnemyService
local Stalker = {}
Stalker.__index = Stalker

function Stalker.new(parent, patrol, context)
    local assets = ServerStorage.LastStopAssets
    local model = assets.Stalker:Clone()
    local root = model.HumanoidRootPart
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    for _, item in model:GetDescendants() do
        if item:IsA("BasePart") then item.Transparency, item.CastShadow = 1, false end
        if item:IsA("Light") or item:IsA("BillboardGui") then item:Destroy() end
    end
    local skin = assets.StalkerSkin:Clone()
    skin.Name = "CreatureVisual"
    local visualFrame, visualSize = skin:GetBoundingBox()
    local desiredCenter = root.CFrame * CFrame.new(0, visualSize.Y / 2 - 5, 0)
    skin:PivotTo(desiredCenter * visualFrame:Inverse() * skin:GetPivot())
    skin.Parent = model
    for _, part in skin:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored, part.CanCollide, part.CanTouch, part.Massless = false, false, false, true
            local weld = Instance.new("WeldConstraint")
            weld.Part0, weld.Part1, weld.Parent = root, part, part
        end
    end
    model:PivotTo(CFrame.new(patrol[1]))
    model:SetAttribute("V4Stalker", true)
    model:SetAttribute("AIState", "Patrol")
    model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    model.Parent = parent
    humanoid.WalkSpeed, humanoid.DisplayDistanceType = 7, Enum.HumanoidDisplayDistanceType.None
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") then part.CollisionGroup = "LastStopEnemy" end
    end
    root:SetNetworkOwner(nil)
    local self = setmetatable({model = model, root = root, humanoid = humanoid, context = context,
        patrolPoints = patrol, patrolIndex = 2, lastPath = 0, generation = 0, attackAt = -10,
        state = "Patrol", think = 0, memoryUntil = 0, lastPosition = root.Position, stuckTime = 0,
        random = Random.new(), alertUntil = 0, lurkUntil = 0}, Stalker)
    self.moveConnection = humanoid.MoveToFinished:Connect(function(reached)
        if self.destroyed or not self.waypoints or self.humanoid.WalkSpeed == 0 then return end
        local point = self.waypoints[self.waypointIndex]
        if reached and point and (self.root.Position - point.Position).Magnitude < 6 then
            self.waypointIndex += 1
            self:_nextWaypoint()
        else
            self.waypoints, self.lastPath = nil, 0
        end
    end)
    return self
end

function Stalker:_setState(state)
    if self.state == state then return end
    self.state = state
    self.stuckTime, self.lastPosition = 0, self.root.Position
    self.model:SetAttribute("AIState", state)
    self.model:SetAttribute("StateChangedAt", workspace:GetServerTimeNow())
end

function Stalker:_canSee(root)
    local params = RaycastParams.new()
    params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, {self.model}
    local origin = self.root.Position + Vector3.new(0, 1, 0)
    local hit = workspace:Raycast(origin, root.Position - origin, params)
    return not hit or hit.Instance:IsDescendantOf(root.Parent)
end

function Stalker:_pickPatrolIndex()
    -- Random next point that is never the one just reached, so routes vary per run.
    return SubwayCycle.PickPatrolIndex(self.random, #self.patrolPoints, self.patrolIndex)
end

function Stalker:_nextWaypoint()
    if self.humanoid.WalkSpeed == 0 then return end
    local point = self.waypoints and self.waypoints[self.waypointIndex]
    if not point then self.waypoints, self.lastPath = nil, 0; return end
    if point.Action == Enum.PathWaypointAction.Jump then self.humanoid.Jump = true end
    self.humanoid:MoveTo(point.Position)
end

function Stalker:_pathTo(position)
    if self.waypoints and self.pathDestination and (position - self.pathDestination).Magnitude < 5 then return end
    if self.computing or os.clock() - self.lastPath < 1 then return end
    self.lastPath = os.clock()
    self.generation += 1
    local generation = self.generation
    local requestedState = self.state
    self.pathDestination = position
    self.computing = true
    task.spawn(function()
        local path = PathfindingService:CreatePath({AgentRadius = 1.6, AgentHeight = 8, AgentCanJump = true, WaypointSpacing = 5, Costs = GameConfig.NavigationCosts})
        local ok = pcall(function() path:ComputeAsync(self.root.Position, position) end)
        self.computing = false
        if self.destroyed or generation ~= self.generation or self.state ~= requestedState then path:Destroy(); return end
        if self.blockedConnection then self.blockedConnection:Disconnect() end
        if self.path then self.path:Destroy() end
        self.path = path
        if ok and path.Status == Enum.PathStatus.Success then
            self.waypoints, self.waypointIndex = path:GetWaypoints(), 2
            self.blockedConnection = path.Blocked:Connect(function(index)
                if self.waypoints and index >= self.waypointIndex then self.waypoints, self.lastPath = nil, 0 end
            end)
            self:_nextWaypoint()
        else
            self.waypoints = nil
            self.humanoid:MoveTo(self.root.Position)
        end
    end)
end

function Stalker:_attack(player)
    self.attackAt = os.clock()
    self:_setState("Windup")
    self.humanoid:MoveTo(self.root.Position)
    self.humanoid.WalkSpeed = 0
    task.delay(.85, function()
        if self.destroyed then return end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root and (root.Position - self.root.Position).Magnitude < 5.3 and self:_canSee(root) then
            self.context.damagePlayer(player, 20, "Stalker")
        end
        self:_setState("Recovery")
        task.delay(.65, function()
            if not self.destroyed then self:_setState("Search"); self.lastPath = 0 end
        end)
    end)
end

function Stalker:Update(dt)
    if self.destroyed or not self.root.Parent then return end
    self.think += dt
    if self.think < .2 then return end
    local elapsed = self.think
    self.think = 0
    if self.state == "Windup" or self.state == "Recovery" then return end
    local player, target, distance = nil, nil, 66
    local noisePosition
    for _, candidate in self.context.getActivePlayers() do
        local character = candidate.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local health = character and character:FindFirstChildOfClass("Humanoid")
        if root and health and health.Health > 0 and (not self.context.canTargetPlayer or self.context.canTargetPlayer(candidate)) then
            local range = (root.Position - self.root.Position).Magnitude
            local direction = root.Position - self.root.Position
            local inCone = range < 15 or direction.Unit:Dot(self.root.CFrame.LookVector) > -.25
            if range < distance and inCone and self:_canSee(root) then
                player, target, distance = candidate, root, range
            elseif range < 38 and (candidate:GetAttribute("NoiseUntil") or 0) > workspace:GetServerTimeNow() then
                noisePosition = root.Position
            end
        end
    end
    if target then
        self.lastSeen, self.memoryUntil = target.Position, os.clock() + 7
        if distance < 5.2 and os.clock() - self.attackAt > 2.8 then self:_attack(player); return end
        -- Fair counterplay: a sighting first shows a short, visible Alert (the stalker
        -- stops and turns) before it commits to the chase.
        if self.state ~= "Chase" then
            if self.state ~= "Alert" then
                self:_setState("Alert")
                -- Long enough to read: a clear, visible turn before the chase commits.
                self.alertUntil = os.clock() + 1.2
                self.waypoints = nil
                self.humanoid:MoveTo(self.root.Position)
            end
            if os.clock() < self.alertUntil then return end
        end
        self:_setState("Chase")
        self.humanoid.WalkSpeed = 13
        self.waypoints = nil
        self.humanoid:MoveTo(target.Position)
    elseif self.lastSeen and os.clock() < self.memoryUntil then
        self:_setState("Search")
        self.humanoid.WalkSpeed = 10
        self:_pathTo(self.lastSeen)
    elseif noisePosition then
        self:_setState("Investigate")
        self.humanoid.WalkSpeed = 9
        self.lastSeen, self.memoryUntil = noisePosition, os.clock() + 4
        self:_pathTo(noisePosition)
    else
        local point = self.patrolPoints[self.patrolIndex] or self.patrolPoints[1]
        if (self.root.Position - point).Magnitude < 6 then
            self.patrolIndex = self:_pickPatrolIndex()
            self.lastPath = 0
            -- Sometimes the stalker stops and listens for a few seconds before moving on.
            if self.random:NextNumber() < .35 then self.lurkUntil = os.clock() + self.random:NextNumber(2, 4) end
        end
        if os.clock() < self.lurkUntil then
            self:_setState("Lurk")
            self.waypoints = nil
            self.humanoid.WalkSpeed = 0
            self.humanoid:MoveTo(self.root.Position)
        else
            self:_setState("Patrol")
            self.humanoid.WalkSpeed = 7
            self:_pathTo(self.patrolPoints[self.patrolIndex])
        end
    end
    if self.humanoid.WalkSpeed > 0 and (not target or distance > 5.3) and (self.root.Position - self.lastPosition).Magnitude < .15 then
        self.stuckTime += elapsed
    else
        self.stuckTime = 0
    end
    self.lastPosition = self.root.Position
    if self.stuckTime > 2 then
        self.humanoid.Jump = true
        self.waypoints, self.lastPath, self.stuckTime = nil, 0, 0
        self.patrolIndex = self.patrolIndex % #self.patrolPoints + 1
    end
end

function Stalker:Destroy()
    self.destroyed, self.generation = true, self.generation + 1
    self.moveConnection:Disconnect()
    if self.blockedConnection then self.blockedConnection:Disconnect() end
    if self.path then self.path:Destroy() end
    self.model:Destroy()
end
function EnemyService.new()
    for _, name in {"LastStopPlayers", "LastStopEnemy"} do
        if not PhysicsService:IsCollisionGroupRegistered(name) then PhysicsService:RegisterCollisionGroup(name) end
    end
    PhysicsService:CollisionGroupSetCollidable("LastStopPlayers", "LastStopEnemy", false)
    return setmetatable({_enemies = {}}, EnemyService)
end
function EnemyService:SpawnStalker(parent, patrol, context)
    local enemy = Stalker.new(parent, patrol, context)
    table.insert(self._enemies, enemy)
    return enemy
end
function EnemyService:Start()
    self._connection = RunService.Heartbeat:Connect(function(dt)
        for _, enemy in self._enemies do enemy:Update(dt) end
    end)
end
function EnemyService:Clear()
    for _, enemy in self._enemies do enemy:Destroy() end
    table.clear(self._enemies)
end
function EnemyService:Destroy()
    self:Clear()
    if self._connection then self._connection:Disconnect() end
end
return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">EnvironmentService</string>
          <string name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local Environment = {}
local cyan = Color3.fromRGB(92, 210, 202)
local amber = Color3.fromRGB(246, 168, 66)
local dark = Color3.fromRGB(24, 36, 44)
local meshLibrary

function Environment.Part(parent, name, size, cframe, color, material)
    local part = Instance.new("Part")
    part.Name, part.Size, part.CFrame = name, size, cframe
    part.Color, part.Material = color or dark, material or Enum.Material.Metal
    if part.Material == Enum.Material.Metal then part.MaterialVariant = "MetalPlate" end
    part.Anchored, part.TopSurface, part.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

function Environment.Mesh(parent, name, cframe, size)
    meshLibrary = meshLibrary or ServerStorage.LastStopAssets:WaitForChild("Environment")
    local source = meshLibrary:FindFirstChild(name, true)
    assert(source and source:IsA("MeshPart"), "Missing imported mesh " .. name)
    local mesh = source:Clone()
    mesh.Anchored, mesh.CanTouch = true, false
    mesh.CFrame = cframe
    if size then mesh.Size = size end
    if name == "floor-panel" or name == "wall" or name == "wall-window" or name == "rail" or name == "pipe" or name == "container" or name == "container-tall" then
        mesh.TextureID = ""
        mesh.Material, mesh.MaterialVariant = Enum.Material.Metal, "PaintedSteel"
        mesh.Color = Color3.fromRGB(145, 165, 171)
    end
    mesh.Parent = parent
    return mesh
end

function Environment.Sign(parent, text, position, size, color, yaw)
    local board = Environment.Part(parent, "Wayfinding", size or Vector3.new(12, 2, .12),
        CFrame.new(position) * CFrame.Angles(0, math.rad(yaw or 0), 0), dark)
    local gui = Instance.new("SurfaceGui")
    gui.Face, gui.CanvasSize, gui.LightInfluence = Enum.NormalId.Front, Vector2.new(1024, 160), .15
    gui.Parent = board
    local label = Instance.new("TextLabel")
    label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    label.Font, label.TextScaled, label.Text = Enum.Font.GothamMedium, true, text
    label.TextColor3, label.Parent = color or cyan, gui
    return board
end

function Environment.Light(parent, position, color, range)
    local housing = Environment.Part(parent, "RecessedLuminaire", Vector3.new(5, .3, 1.2), CFrame.new(position), dark)
    local strip = Environment.Part(parent, "Diffuser", Vector3.new(4.5, .12, .7), CFrame.new(position - Vector3.new(0, .22, 0)), color, Enum.Material.Neon)
    strip.CanCollide = false
    local light = Instance.new("PointLight")
    light.Color, light.Brightness, light.Range, light.Shadows = color, 1.6, range or 22, false
    light.Parent = strip
    return housing
end

function Environment.UpgradeLobby(model)
    local art = Instance.new("Folder")
    art.Name, art.Parent = "ImportedConcourse", model
    for _, x in {-38, 38} do
        for z = -24, 24, 8 do
            local panel = Environment.Mesh(art, "wall-window", CFrame.new(x, 8, z) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(8, 16, 2.4))
            panel.CanCollide = false
        end
    end
    for _, x in {-25, 25} do
        Environment.Mesh(art, "display-wall-wide", CFrame.new(x, 6, -32), Vector3.new(12, 8, 3))
        Environment.Light(art, Vector3.new(x, 14, -24), cyan, 28)
        for z = -12, 12, 12 do
            Environment.Mesh(art, "container-tall", CFrame.new(x > 0 and 34 or -34, 3.6, z))
        end
    end
    Environment.Mesh(art, "computer-system", CFrame.new(14, 2.4, -11))
    model.QueueConsole.Transparency = 1
    model.QueueConsole.CFrame = CFrame.new(14, 3.4, -7)
    model.QueueConsole.CanCollide = false
    model.QueueConsole.CanQuery = false
    for z = -8, 24, 8 do
        local floor = Environment.Mesh(art, "floor-panel", CFrame.new(0, -.4, z), Vector3.new(14, .8, 8))
        floor.CanCollide = false
    end
    Environment.Sign(art, "CONTAINMENT TRANSIT  /  AUTHORIZED CREW", Vector3.new(0, 13, -16), Vector3.new(25, 1.8, .15))
end

local function leak(parent, position, color)
    local source = Environment.Part(parent, "PipeLeak", Vector3.one * .1, CFrame.new(position))
    source.Transparency, source.CanCollide, source.CanQuery = 1, false, false
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color, emitter.LightEmission = ColorSequence.new(color), .3
    emitter.Size = NumberSequence.new(.08)
    emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, .4), NumberSequenceKeypoint.new(1, 1)})
    emitter.Lifetime, emitter.Speed, emitter.Rate = NumberRange.new(.6, .9), NumberRange.new(9, 13), 12
    emitter.Acceleration, emitter.EmissionDirection = Vector3.new(0, -18, 0), Enum.NormalId.Bottom
    emitter.SpreadAngle, emitter.Parent = Vector2.new(3, 3), source
end

function Environment.UpgradeHospital(model)
    local origin = model:GetPivot()
    local identifier = model:FindFirstChild("HospitalIdentifier", true)
    if identifier then identifier.CFrame = origin * CFrame.new(0, 10.5, 33.5) end
    local art = Instance.new("Folder")
    art.Name, art.Parent = "ImportedArchitecture", model
    local replacements = {}
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") and part.Name == "Wall" then
            table.insert(replacements, part)
        end
    end
    for _, part in replacements do
        -- Mesh wall panels retain the existing collision/layout contract.
        local width = math.max(part.Size.X, part.Size.Z)
        local yaw = part.Size.Z > part.Size.X and math.pi / 2 or 0
        local count = math.max(1, math.ceil(width / 8))
        for index = 1, count do
            local offset = (index - .5) * width / count - width / 2
            local cframe = CFrame.new(part.Position) * CFrame.Angles(0, yaw, 0) * CFrame.new(offset, 0, 0)
            local mesh = Environment.Mesh(art, "wall", cframe, Vector3.new(width / count, part.Size.Y, .8))
            mesh.CanCollide = false
            mesh.Color = Color3.fromRGB(150, 164, 158)
        end
        part.Transparency = 1
    end
    local props = {
        {"bed-single", -23, 2, -8}, {"bed-single", -23, 2, 5},
        {"computer-wide", 28, 3, 10}, {"computer-system", 19, 3, -28},
        {"container-tall", -29, 3.6, 24}, {"container", 29, 2.4, 27},
    }
    for _, entry in props do
        Environment.Mesh(art, entry[1], origin * CFrame.new(entry[2], entry[3], entry[4]))
    end
    -- Abandoned clinic dressing: overturned gurneys, a toppled IV stand, a dark
    -- nurses' station and peeling paint bands so the ward reads as left behind.
    local grime = Color3.fromRGB(96, 104, 92)
    for index, z in {-16, 14} do
        local gurney = Environment.Part(art, "GurneyFrame", Vector3.new(2.2, .4, 6.2), origin * CFrame.new(-14 + index * 3, 1.1, z) * CFrame.Angles(0, 0, math.rad(index == 1 and 78 or -64)), Color3.fromRGB(120, 128, 126), Enum.Material.Metal)
        gurney.CanCollide = false
    end
    local stand = Environment.Part(art, "IVStand", Vector3.new(.3, 6, .3), origin * CFrame.new(-6, 3, 14) * CFrame.Angles(0, 0, math.rad(82)), Color3.fromRGB(190, 190, 186), Enum.Material.Metal)
    stand.CanCollide = false
    Environment.Part(art, "NursesStation", Vector3.new(10, 3, 3), origin * CFrame.new(24, 1.5, -14), Color3.fromRGB(70, 58, 50), Enum.Material.Wood)
    for _, z in {-30, -10, 10, 30} do
        local band = Environment.Part(art, "PeelingPaint", Vector3.new(.2, 2.4, 6), origin * CFrame.new(-17.8, 6.2, z), grime, Enum.Material.Concrete)
        band.CanCollide = false
        band.Transparency = .35
    end
    for _, x in {-29, -19} do
        Environment.Mesh(art, "container", origin * CFrame.new(x, 1.2, -1), Vector3.new(3, 2.4, 2.4))
    end
    for z = -29, 27, 8 do
        local mesh = Environment.Mesh(art, "floor-panel", origin * CFrame.new(0, -.55, z), Vector3.new(12, 1, 8))
        mesh.CanCollide = false
    end
    Environment.Sign(art, "SAINT ORIN   /   CONTAINMENT WARD", origin:PointToWorldSpace(Vector3.new(0, 9, -35)), Vector3.new(13, 1.4, .1))
    Environment.Sign(art, "CLOSED  -  NO ADMISSIONS", origin:PointToWorldSpace(Vector3.new(-25, 7, 33)), Vector3.new(9, 1.2, .1), Color3.fromRGB(182, 74, 64))
    for _, x in {-5.5, 5.5} do
        local strip = Environment.Part(art, "DischargeBoundary", Vector3.new(.15, .1, 24), origin * CFrame.new(x, .15, -12), amber, Enum.Material.Neon)
        strip.CanCollide = false
        strip:SetAttribute("HazardIndicator", true)
    end
    Environment.Sign(art, "DISCHARGE ZONE  /  USE SIDE WARDS DURING ALARM", origin:PointToWorldSpace(Vector3.new(0, 8, -4)), Vector3.new(12, 1.2, .1), amber)
    -- Clinical atmosphere: tiled wainscot, ceiling light fittings the power flicker
    -- drives (tagged FlickerLight), a crash cart and an oxygen cart for medical detail.
    local tile = Color3.fromRGB(176, 186, 184)
    for _, x in {-17.8, 17.8} do
        local wainscot = Environment.Part(art, "TiledWainscot", Vector3.new(.2, 3.2, 58), origin * CFrame.new(x, 2.4, 0), tile, Enum.Material.Marble)
        wainscot.CanCollide = false
    end
    for _, z in {-26, -6, 14} do
        for _, x in {-8, 8} do
            local fitting = Environment.Part(art, "CeilingLight", Vector3.new(2.4, .3, 4), origin * CFrame.new(x, 9.6, z), Color3.fromRGB(230, 236, 230), Enum.Material.Neon)
            fitting.CanCollide = false
            fitting:SetAttribute("FlickerLight", true)
        end
    end
    local crash = Environment.Part(art, "CrashCart", Vector3.new(2.2, 3, 1.4), origin * CFrame.new(26, 1.5, 3), Color3.fromRGB(190, 40, 40), Enum.Material.Metal)
    crash.CanCollide = false
    local oxygen = Environment.Part(art, "OxygenCart", Vector3.new(1.2, 3.4, 1.2), origin * CFrame.new(-26, 1.7, -22), Color3.fromRGB(50, 110, 70), Enum.Material.Metal)
    oxygen.CanCollide = false
    -- Thin decorative curtains/tiles must not hide interactive prompts.
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") and not part.CanCollide then part.CanQuery = false end
    end
    return model
end

-- Abandoned subway: a long platform hall flanking a single track. A stopped
-- train sits in the tunnel to the north and periodically rolls through the
-- track bed, so the central rail is a lethal lane during its pass.
function Environment.BuildSubway()
    local model = Instance.new("Model")
    model.Name = "AbandonedSubway"
    local origin = Environment.Part(model, "Origin", Vector3.one * .1, CFrame.new(), dark)
    origin.Transparency, origin.CanCollide, origin.CanQuery = 1, false, false
    model.PrimaryPart = origin
    local architecture = Instance.new("Folder")
    architecture.Name, architecture.Parent = "ImportedArchitecture", model
    local tile = Color3.fromRGB(84, 92, 86)
    local grime = Color3.fromRGB(42, 46, 44)
    -- Track bed in the centre, platforms on either side, raised 4 studs.
    local trackBed = Environment.Part(model, "TrackBed", Vector3.new(12, 1, 110), CFrame.new(0, -3.5, 0), Color3.fromRGB(28, 30, 30), Enum.Material.Concrete)
    local trackCost = Instance.new("PathfindingModifier")
    trackCost.Label, trackCost.Parent = "TrainTrack", trackBed
    for _, x in {-22, 22} do
        Environment.Part(model, "Platform", Vector3.new(16, 1, 110), CFrame.new(x, -.5, 0), tile, Enum.Material.Concrete)
        Environment.Part(model, "PlatformEdge", Vector3.new(.8, 1.2, 110), CFrame.new(x + (x > 0 and -7.6 or 7.6), .1, 0), Color3.fromRGB(214, 176, 62), Enum.Material.Metal)
    end
    Environment.Part(model, "Floor", Vector3.new(60, 1, 120), CFrame.new(0, -4.5, 0), grime, Enum.Material.Concrete)
    -- Tunnel walls and a vaulted ceiling line.
    for _, x in {-30, 30} do
        Environment.Part(model, "TunnelWall", Vector3.new(2, 18, 120), CFrame.new(x, 4, 0), grime, Enum.Material.Concrete)
    end
    Environment.Part(model, "Ceiling", Vector3.new(60, 1, 120), CFrame.new(0, 13, 0), grime, Enum.Material.Concrete)
    for z = -54, 54, 18 do
        for _, x in {-16, 16} do
            Environment.Mesh(architecture, "container-tall", CFrame.new(x, 5, z), Vector3.new(4, 12, 4))
        end
    end
    -- Level crossings connect both platforms without requiring a jump out of the track bed.
    Environment.Part(model, "NorthCrossing", Vector3.new(60, 1, 8), CFrame.new(0, -.5, -46), tile, Enum.Material.Concrete)
    Environment.Sign(architecture, "USE MARKED CROSSINGS / CLEAR TRACK ON WARNING", Vector3.new(0, 9, -46), Vector3.new(26, 2, .15), amber)
    Environment.Sign(architecture, "LAST TRAIN   /   NORTHBOUND  -  NOT IN SERVICE", Vector3.new(0, 10, -55), Vector3.new(20, 2, .15), amber)
    Environment.Sign(architecture, "SIGNAL RELAY  /  AUTHORIZED STAFF ONLY", Vector3.new(0, 10, 55), Vector3.new(18, 2, .15), cyan)
    for z = -48, 48, 16 do
        Environment.Light(model, Vector3.new(-22, 11, z), Color3.fromRGB(230, 214, 176), 24)
        Environment.Light(model, Vector3.new(22, 11, z), Color3.fromRGB(230, 214, 176), 24)
    end
    -- The visual train never collides with characters. Server bounds apply damage.
    -- The train is a model the server moves with PivotTo. Its position drives
    -- the warning, the visible motion and the damage lane from one value.
    local train = Instance.new("Model")
    train.Name, train.Parent = "Train", model
    local car = Environment.Part(train, "TrainCar", Vector3.new(11, 8, 40), CFrame.new(0, 1.5, -86), Color3.fromRGB(70, 96, 74), Enum.Material.Metal)
    car.CanCollide = false
    car:SetAttribute("HazardIndicator", true)
    local headlight = Environment.Part(train, "Headlight", Vector3.new(2, 2, .4), CFrame.new(0, 3, -106.2), Color3.fromRGB(255, 244, 210), Enum.Material.Neon)
    headlight.CanCollide = false
    train.PrimaryPart = car
    local markers = Instance.new("Folder")
    markers.Name, markers.Parent = "Markers", model
    local function marker(name, position, size)
        local part = Environment.Part(markers, name, size or Vector3.one, CFrame.new(position))
        part.Transparency, part.CanCollide, part.CanQuery = 1, false, false
        return part
    end
    marker("EntranceSpawn", Vector3.new(-22, 4, 46))
    local elevatorSocket = marker("ElevatorSocket", Vector3.new(0, 0, 62))
    elevatorSocket.CFrame *= CFrame.Angles(0, math.pi, 0)
    marker("ElevatorReturnZone", Vector3.new(0, 5, 62), Vector3.new(18, 10, 16))
    marker("EnemySpawn", Vector3.new(-22, 4, -40))
    marker("RoomBounds", Vector3.new(0, 5, 0), Vector3.new(60, 20, 130))
    local paths = Instance.new("Folder")
    paths.Name, paths.Parent = "PatrolPaths", markers
    for index, position in {Vector3.new(-22, 4, -20), Vector3.new(22, 4, 0), Vector3.new(-22, 4, 20), Vector3.new(22, 4, 40)} do
        local point = Environment.Part(paths, tostring(index), Vector3.one, CFrame.new(position))
        point.Transparency, point.CanCollide, point.CanQuery = 1, false, false
    end
    -- Return bridge from the platform edge to the elevator socket.
    Environment.Part(model, "ElevatorBridge", Vector3.new(60, 1, 16), CFrame.new(0, -.5, 56), dark)
    return model
end

function Environment.BuildLaboratory()
    local model = Instance.new("Model")
    model.Name = "FloodedLaboratory"
    local origin = Environment.Part(model, "Origin", Vector3.one * .1, CFrame.new(), dark)
    origin.Transparency, origin.CanCollide, origin.CanQuery = 1, false, false
    model.PrimaryPart = origin
    local architecture = Instance.new("Folder")
    architecture.Name, architecture.Parent = "ImportedArchitecture", model
    local basin = Environment.Part(model, "Basin", Vector3.new(94, 1, 110), CFrame.new(0, -4, 0), dark, Enum.Material.Concrete)
    local basinCost = Instance.new("PathfindingModifier")
    basinCost.Label, basinCost.Parent = "FloodBasin", basin
    local water = Environment.Part(model, "FloodWater", Vector3.new(90, .16, 106), CFrame.new(0, -1.1, 0), Color3.fromRGB(32, 87, 95), Enum.Material.Glass)
    water.Transparency, water.Reflectance, water.CanCollide = .38, .2, false
    water:SetAttribute("WaterSurface", true)
    -- The cross and perimeter are continuous, wide enough for two players to pass.
    local walkways = {
        {0, 0, 12, 106}, {0, 0, 90, 12}, {-39, 0, 12, 106}, {39, 0, 12, 106},
        {0, -47, 90, 12}, {0, 47, 90, 12},
    }
    for _, entry in walkways do
        local x, z, width, length = table.unpack(entry)
        Environment.Part(model, "CatwalkCollision", Vector3.new(width, 1, length), CFrame.new(x, -.5, z), Color3.fromRGB(120, 140, 146))
        for dx = -width / 2 + 6, width / 2 - 1, 12 do
            for dz = -length / 2 + 6, length / 2 - 1, 12 do
                Environment.Mesh(architecture, "floor-panel", CFrame.new(x + dx, -.4, z + dz), Vector3.new(12, .8, 12))
            end
        end
    end
    for x = -40, 40, 8 do
        for _, z in {-55, 55} do
            if z == -55 or math.abs(x) > 8 then
                Environment.Mesh(architecture, "wall-window", CFrame.new(x, 7, z), Vector3.new(8, 14, 2.4))
            end
        end
    end
    for z = -47, 49, 8 do
        for _, x in {-47, 47} do
            Environment.Mesh(architecture, "wall", CFrame.new(x, 7, z) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(8, 14, 2.4))
        end
    end
    for _, x in {-25, 25} do
        for _, z in {-27, 27} do
            local plinth = Environment.Part(model, "ContainmentPlinth", Vector3.new(13, 1.5, 13), CFrame.new(x, -2, z), dark)
            Environment.Mesh(architecture, "container-tall", CFrame.new(x, 2, z), Vector3.new(6, 9, 6))
            local glass = Environment.Part(model, "ContainmentCylinder", Vector3.new(11, 7.5, 7.5), CFrame.new(x, 3.5, z), cyan, Enum.Material.Glass)
            glass.Shape, glass.Transparency, glass.CanCollide = Enum.PartType.Cylinder, .78, false
            glass.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
            Environment.Light(model, Vector3.new(x, 11, z), cyan, 23)
        end
    end
    for _, x in {-38, 38} do
        for z = -40, 40, 16 do
            Environment.Mesh(architecture, "rail", CFrame.new(x > 0 and 32 or -32, 1.6, z) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(12, 3.2, .5))
            Environment.Light(model, Vector3.new(x, 12, z), Color3.fromRGB(153, 199, 204))
        end
    end
    for _, x in {-44, 44} do
        for z = -36, 36, 12 do
            Environment.Mesh(architecture, "pipe", CFrame.new(x, 10, z), Vector3.new(2, 12, 2))
        end
    end
    -- Recovery ramps cross the gaps between rail segments, so falling into
    -- the basin never leaves a player trapped below the raised catwalk.
    for _, x in {-30, 30} do
        for _, z in {-32, 32} do
            local slope = math.atan(3.5 / 12) * (x > 0 and 1 or -1)
            Environment.Part(model, "BasinAccessRamp", Vector3.new(12.5, 1, 4),
                CFrame.new(x, -2.25, z) * CFrame.Angles(0, 0, slope), amber)
        end
    end
    Environment.Mesh(architecture, "computer-system", CFrame.new(-37, 2.4, -44))
    Environment.Mesh(architecture, "computer-system", CFrame.new(37, 2.4, -44))
    Environment.Mesh(architecture, "computer-wide", CFrame.new(0, 2, -45))
    for _, x in {-37, 37} do
        Environment.Mesh(architecture, "computer-system", CFrame.new(x, 2.4, 34))
        Environment.Mesh(architecture, "pipe-bend", CFrame.new(x > 0 and 43 or -43, 3, 38), Vector3.new(5, 5, 3))
        Environment.Mesh(architecture, "wall-detail", CFrame.new(x, 7, 52), Vector3.new(5, 7, 1.4))
        leak(model, Vector3.new(x, 11, -24), cyan)
    end
    Environment.Sign(model, "PELAGIC   /   SUBLEVEL 06", Vector3.new(0, 10, -53), Vector3.new(26, 2.5, .15))
    Environment.Sign(model, "PUMP A     ←     RAISED ROUTE     →     PUMP B", Vector3.new(0, 7, 12), Vector3.new(22, 1.5, .15), amber)
    Environment.Part(model, "Ceiling", Vector3.new(96, 1, 112), CFrame.new(0, 16, 0), Color3.fromRGB(67, 85, 94))
    for z = -48, 48, 16 do
        Environment.Part(model, "StructuralBeam", Vector3.new(94, .7, .8), CFrame.new(0, 14, z), Color3.fromRGB(86, 106, 116))
        Environment.Light(model, Vector3.new(0, 13, z), Color3.fromRGB(161, 206, 213), 30)
    end
    for _, x in {-6.2, 6.2} do
        local strip = Environment.Part(model, "CatwalkEdgeLight", Vector3.new(.12, .12, 100), CFrame.new(x, .12, 0), cyan, Enum.Material.Neon)
        strip.CanCollide = false
        strip:SetAttribute("HazardIndicator", true)
    end
    local markers = Instance.new("Folder")
    markers.Name, markers.Parent = "Markers", model
    local function marker(name, position, size)
        local part = Environment.Part(markers, name, size or Vector3.one, CFrame.new(position))
        part.Transparency, part.CanCollide, part.CanQuery = 1, false, false
        return part
    end
    marker("EntranceSpawn", Vector3.new(0, 4, 43))
    local elevatorSocket = marker("ElevatorSocket", Vector3.new(0, 0, 63))
    elevatorSocket.CFrame *= CFrame.Angles(0, math.pi, 0)
    marker("ElevatorReturnZone", Vector3.new(0, 5, 63), Vector3.new(18, 10, 16))
    marker("EnemySpawn", Vector3.new(0, 5, -40))
    marker("RoomBounds", Vector3.new(0, 5, 0), Vector3.new(96, 20, 130))
    local paths = Instance.new("Folder")
    paths.Name, paths.Parent = "PatrolPaths", markers
    for index, position in {Vector3.new(0, 4, -40), Vector3.new(-38, 4, 0), Vector3.new(0, 4, 40), Vector3.new(38, 4, 0)} do
        local point = Environment.Part(paths, tostring(index), Vector3.one, CFrame.new(position))
        point.Transparency, point.CanCollide, point.CanQuery = 1, false, false
    end
    -- Bridge through the opening to the return elevator.
    Environment.Part(model, "ElevatorBridge", Vector3.new(18, 1, 16), CFrame.new(0, -.5, 56), dark)
    return model
end

return Environment
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ExpeditionService</string>
          <string name="Source"><![CDATA[-- Server-owned expedition state machine. The client receives snapshots for UI
-- only; it never supplies damage, coins, objective progress, or escape status.
local FloorConfig = require(game:GetService("ReplicatedStorage").Shared.Config.FloorConfig)

local ExpeditionService = {}
ExpeditionService.__index = ExpeditionService

-- Fixed reward for the optional hidden stash in each floor (server-owned).
local HIDDEN_LOOT_COINS = 35

local function inBox(position, cframe, size)
	local localPosition = cframe:PointToObjectSpace(position)
	local half = size * 0.5
	return math.abs(localPosition.X) <= half.X
		and math.abs(localPosition.Y) <= half.Y
		and math.abs(localPosition.Z) <= half.Z
end

local function characterRoot(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function characterHumanoid(player)
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function ExpeditionService.new(config, floorService, enemyService, economyService, profileService, inventoryService, remotes, onFinished)
	return setmetatable({
		_config = config,
		_floorService = floorService,
		_enemyService = enemyService,
		_economyService = economyService,
		_profileService = profileService,
		_inventoryService = inventoryService,
		_remotes = remotes,
		_onFinished = onFinished,
		state = "Idle",
		_token = 0,
		active = {},
		allPlayers = {},
		unbanked = {},
		pendingXP = {},
		votes = {},
		recentFloorIds = {},
		connections = {},
		depth = 0,
		floor = nil,
		floorDefinition = nil,
	}, ExpeditionService)
end

function ExpeditionService:IsRunning()
	return self.state ~= "Idle" and self.state ~= "Ended"
end

function ExpeditionService:_activePlayers()
	local result = {}
	for player in pairs(self.active) do
		if player.Parent then
			table.insert(result, player)
		end
	end
	return result
end

function ExpeditionService:_activeCount()
	return #self:_activePlayers()
end

function ExpeditionService:_send(player, patch)
	if not player.Parent then
		return
	end
	local payload = {
		state = self.state,
		depth = self.depth,
		floorName = self.floorDefinition and self.floorDefinition.Name or "Lobby",
		objective = self.floor and self.floor.objective or (self.floorDefinition and self.floorDefinition.Prompt or "Queue for an expedition."),
		progress = self.floor and select(1, self.floor:ObjectiveProgress()) or 0,
		target = self.floorDefinition and self.floorDefinition.Target or 0,
		unbanked = self.unbanked[player] or 0,
		banked = self._economyService:GetBankedCoins(player),
		activePlayers = self:_activeCount(),
		seed = self.seed,
	}
	for key, value in pairs(patch or {}) do
		payload[key] = value
	end
	player:SetAttribute("LastStopSnapshot", game:GetService("HttpService"):JSONEncode(payload))
	self._remotes.StateChanged:FireClient(player, payload)
end

function ExpeditionService:_broadcast(patch)
	for _, player in ipairs(self:_activePlayers()) do
		self:_send(player, patch)
	end
end

function ExpeditionService:SyncState(player)
	if not self.active[player] then return false end
	self:_send(player, {decisionDeadline = self.decisionDeadline})
	return true
end

function ExpeditionService:_toast(player, text)
	if player.Parent then
		self._remotes.Toast:FireClient(player, text)
	end
end

function ExpeditionService:_setState(nextState, patch)
	self.state = nextState
	self:_broadcast(patch)
end

function ExpeditionService:_movePlayer(player, cframe)
	task.spawn(function()
		if not player.Parent then
			return
		end
		local character = player.Character
		if not character then
			player:LoadCharacter()
			character = player.CharacterAdded:Wait()
		end
		local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
		if root then
			character:PivotTo(cframe)
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		end
	end)
end

function ExpeditionService:_returnToLobby(player)
	local lobby = self._floorService.lobby
	if lobby then
		task.spawn(function()
			if not player.Parent then return end
			local previousCharacter = player.Character
			-- A player can leave between the parent check and LoadCharacter(),
			-- especially when a Studio play session stops. Do not let that race
			-- turn an otherwise-clean expedition teardown into an Output error.
			local loaded = pcall(function()
				if player.Parent then
					player:LoadCharacter()
				end
			end)
			if not loaded or not player.Parent then
				return
			end

			local character = player.Character
			for _ = 1, 120 do
				if not player.Parent then
					return
				end
				if character and character ~= previousCharacter then
					break
				end
				task.wait()
				character = player.Character
			end
			if not character or character == previousCharacter then return end
			local root = character and (character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5))
			if root then
				character:PivotTo(lobby.LobbySpawn)
			end
		end)
	end
end

function ExpeditionService:_watchPlayer(player)
	local function watchCharacter(character)
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
		if humanoid then
			table.insert(self.connections, humanoid.Died:Connect(function()
				self:OnPlayerDied(player, "You were overwhelmed.")
			end))
		end
	end
	if player.Character then
		watchCharacter(player.Character)
	end
	table.insert(self.connections, player.CharacterAdded:Connect(watchCharacter))
end

function ExpeditionService:Start(players)
	assert(not self:IsRunning(), "An expedition is already running")
	self._token += 1
	local token = self._token
	self.state = "Boarding"
	self.depth = 0
	self.seed = (os.time() + math.random(1, 1000000)) % 2147483647
	self.active = {}
	self.allPlayers = {}
	self.unbanked = {}
	self.pendingXP = {}
	self.votes = {}
	self.recentFloorIds = {}
	self.floor = nil
	self.floorDefinition = nil
	for _, player in ipairs(players) do
		self.active[player] = true
		self.allPlayers[player] = true
		self.unbanked[player] = 0
		self.pendingXP[player] = 0
		self._inventoryService:BeginRun(player)
		self:_watchPlayer(player)
		self:_movePlayer(player, self._floorService.lobby.BoardCFrame)
	end
	self._floorService:SetLobbyElevator(true, "BOARD NOW")
	self:_broadcast({ message = "Board the elevator. Departure is imminent." })
	print("[LAST STOP] Expedition seed", self.seed, "players", #players)
	task.spawn(function()
		if not self:_wait(self._config.BoardingSeconds, token) then
			return
		end
		self._floorService:SetLobbyElevator(false, "DESCENDING")
		self:_beginNextFloor(token)
	end)
end

function ExpeditionService:_wait(seconds, token, predicate)
	local finishAt = os.clock() + seconds
	while os.clock() < finishAt do
		if self._token ~= token or not self:IsRunning() then
			return false
		end
		if predicate and predicate() then
			return true
		end
		task.wait(0.2)
	end
	return self._token == token and self:IsRunning()
end

function ExpeditionService:_chooseFloor()
	local candidates = {}
	for _, definition in ipairs(FloorConfig.Floors) do
		local recent = false
		for _, recentId in ipairs(self.recentFloorIds) do
			if recentId == definition.Id then
				recent = true
				break
			end
		end
		if not recent then
			table.insert(candidates, definition)
		end
	end
	if #candidates == 0 then
		candidates = FloorConfig.Floors
	end
	local totalWeight = 0
	for _, definition in ipairs(candidates) do
		totalWeight += definition.Weight
	end
	local random = Random.new(self.seed + self.depth * 104729)
	local roll = random:NextNumber(0, totalWeight)
	for _, definition in ipairs(candidates) do
		roll -= definition.Weight
		if roll <= 0 then
			return definition
		end
	end
	return candidates[#candidates]
end

function ExpeditionService:_beginNextFloor(token)
	if self._token ~= token or self:_activeCount() == 0 then
		self:_end("No eligible players remain.")
		return
	end
	self:_setState("Travel", { message = "Descending..." })
	if not self:_wait(self._config.TravelSeconds, token) then
		return
	end
	self.depth += 1
	self.floorDefinition = self:_chooseFloor()
	table.insert(self.recentFloorIds, self.floorDefinition.Id)
	if #self.recentFloorIds > self._config.RecentFloorWindow then
		table.remove(self.recentFloorIds, 1)
	end
	self.floor = self._floorService:CreateRoom(self.floorDefinition, self.seed + self.depth)
	self.floor:Initialize({
        getActivePlayers = function() return self:_activePlayers() end,
        damagePlayer = function(player, amount, source) self:DamagePlayer(player, amount, source) end,
        notify = function(player, message) self:_toast(player, message) end,
        changed = function(message) self:_broadcast({message = message}) end,
		interactionDistance = self._config.InteractionDistance,
		isPlayerActive = function(player)
			return self.state == "Floor" and self.active[player] == true
		end,
		onObjectiveStep = function(player, key)
			self:_onObjectiveStep(player, key)
		end,
		onHiddenLoot = function(player)
			self:_onHiddenLoot(player)
		end,
	})
	self.floor:Start()
	local startedFloor = self.floor
	self.floorStartedAt = os.clock()
	for index, player in ipairs(self:_activePlayers()) do
		self:_movePlayer(player, self.floor.spawnCFrame * CFrame.new((((index - 1) % 4) - 1.5) * 3, 0, (math.floor((index - 1) / 4) - 1) * 3))
	end
	self:_setState("Floor", { message = self.floorDefinition.Prompt })
	task.delay(5, function()
		if self._token == token and self.state == "Floor" and self.floor == startedFloor then
			self._enemyService:SpawnStalker(self.floor.model, self.floor.patrolPoints, {
				getActivePlayers = function() return self:_activePlayers() end,
				canTargetPlayer = function(player) return not self:_isStalkerProtected(player) end,
				damagePlayer = function(player, amount, source) self:DamagePlayer(player, amount, source) end,
			})
			self:_broadcast({ message = "Something is moving in the dark." })
		end
	end)
	task.delay(self._config.FloorTimeLimitSeconds, function()
		if self._token == token and self.state == "Floor" and self.floor == startedFloor then
			self:_failCurrentFloor("The floor sealed before the objective was completed.")
		end
	end)
end

function ExpeditionService:_onObjectiveStep(player, key)
	if self.state ~= "Floor" or not self.floor then
		return
	end
	local progress, target = self.floor:ObjectiveProgress()
	self:_broadcast({ message = player.DisplayName .. " advanced the objective (" .. progress .. "/" .. target .. ")." })
	if progress >= target then
		task.spawn(function()
			self:_completeCurrentFloor()
		end)
	end
end

function ExpeditionService:_onHiddenLoot(player)
	if self.state ~= "Floor" or not self.floor or self.unbanked[player] == nil then
		return
	end
	-- Fixed server-side reward; the client only reports the touch, never the amount.
	local reward = HIDDEN_LOOT_COINS
	self.unbanked[player] += reward
	self:_toast(player, "Hidden stash found: +" .. reward .. " unbanked coins.")
	self:_broadcast({ message = player.DisplayName .. " found a hidden stash." })
end

function ExpeditionService:_completeCurrentFloor()
	if self.state ~= "Floor" or not self.floor then
		return
	end
	local progress = select(1, self.floor:ObjectiveProgress())
	if progress < self.floorDefinition.Target then
		return
	end
	self.floor:Complete()
	self._enemyService:Clear()
	local coins, xp = self._economyService:CalculateFloorReward(self.depth, progress)
	for _, player in ipairs(self:_activePlayers()) do
		self.unbanked[player] += coins
		self.pendingXP[player] += xp
	end
	self:_enterEscape(self._token, coins)
end

function ExpeditionService:_isInEscapeRegion(player)
	if not self.floor then
		return false
	end
	local root = characterRoot(player)
	local humanoid = characterHumanoid(player)
	return root ~= nil and humanoid ~= nil and humanoid.Health > 0
		and inBox(root.Position, self.floor.escapeCFrame, self.floor.escapeSize)
end

function ExpeditionService:_enterEscape(token, coins)
	if self._token ~= token or self.state ~= "Floor" then
		return
	end
	self:_setState("Escape", { message = "Objective complete. Return to the elevator: +" .. coins .. " at risk." })
	local allSafe = self:_wait(self._config.EscapeSeconds, token, function()
		for _, player in ipairs(self:_activePlayers()) do
			if not self:_isInEscapeRegion(player) then
				return false
			end
		end
		return self:_activeCount() > 0
	end)
	if self._token ~= token or self.state ~= "Escape" then
		return
	end
	for _, player in ipairs(self:_activePlayers()) do
		if not self:_isInEscapeRegion(player) then
			self:_eliminate(player, "You missed the elevator and lost your at-risk haul.")
		end
	end
	if self:_activeCount() == 0 then
		self:_end("No one made the elevator.")
		return
	end
	self:_enterDecision(token)
end

function ExpeditionService:_enterDecision(token)
	if self._token ~= token or self:_activeCount() == 0 then
		return
	end
	self.votes = {}
	self.decisionDeadline = os.time() + self._config.DecisionSeconds
	self:_setState("Decision", {
		message = "BANK to secure your haul, or CONTINUE and keep it at risk.",
		decisionDeadline = self.decisionDeadline,
	})
	self:_wait(self._config.DecisionSeconds, token, function()
		for _, player in ipairs(self:_activePlayers()) do
			if not self.votes[player] then
				return false
			end
		end
		return true
	end)
	if self._token ~= token or self.state ~= "Decision" then
		return
	end
	local continuers = {}
	for _, player in ipairs(self:_activePlayers()) do
		if self.votes[player] == "Continue" then
			table.insert(continuers, player)
		else
			self:_bankAndReturn(player)
		end
	end
	if #continuers == 0 then
		self:_end("All surviving players banked their rewards.")
		return
	end
	if self.floor then
		-- The elevator in the old room is about to be removed. Transfer survivors
		-- to the persistent cabin before travel so gravity cannot kill continuers.
		for index, player in ipairs(continuers) do
			self:_movePlayer(player, self._floorService.lobby.BoardCFrame * CFrame.new((index - 1) * 2, 0, 0))
		end
		self.floor:Cleanup()
		self.floor = nil
	end
	self:_beginNextFloor(token)
end

function ExpeditionService:RequestDecision(player, decision)
	if self.state ~= "Decision" or not self.active[player] then
		return false, "There is no active bank decision."
	end
	if decision ~= "Bank" and decision ~= "Continue" then
		return false, "Invalid decision."
	end
	self.votes[player] = decision
	self:_toast(player, decision == "Bank" and "You will bank at this stop." or "You will continue with your haul at risk.")
	return true
end

function ExpeditionService:RequestMedkit(player)
	return self._inventoryService:UseMedkit(player, function(candidate)
		return candidate == player and self.active[player] == true and (self.state == "Floor" or self.state == "Escape")
	end)
end

function ExpeditionService:_bankAndReturn(player)
	if not self.active[player] then
		return
	end
	local atRisk = self.unbanked[player] or 0
	local secured = self._economyService:Bank(player, atRisk, self.pendingXP[player] or 0, self.depth)
	self.active[player] = nil
	self.unbanked[player] = 0
	self.pendingXP[player] = 0
	self._inventoryService:EndRun(player)
	self:_send(player, { state = "Results", result = "BANKED", secured = secured, message = "Secured " .. secured .. " coins." })
	self:_returnToLobby(player)
	self._floorService:SetLobbyElevator(true, "LAST STOP")
end

function ExpeditionService:_eliminate(player, reason)
	if not self.active[player] then
		return
	end
	local lost = self.unbanked[player] or 0
	self.active[player] = nil
	self.unbanked[player] = 0
	self.pendingXP[player] = 0
	self._inventoryService:EndRun(player)
	self:_send(player, { state = "Results", result = "LOST", lost = lost, message = reason })
	self:_returnToLobby(player)
	self._floorService:SetLobbyElevator(true, "LAST STOP")
end

function ExpeditionService:_isStalkerProtected(player)
	local root = characterRoot(player)
	if not self.floor or not root then return true end
	return os.clock() - self.floorStartedAt < self._config.StalkerArrivalGraceSeconds
		or (root.Position - self.floor.spawnCFrame.Position).Magnitude < self._config.StalkerArrivalSafeRadius
end

function ExpeditionService:DamagePlayer(player, amount, source)
	if not self.active[player] or (self.state ~= "Floor" and self.state ~= "Escape") then
		return
	end
	if type(amount) ~= "number" or amount <= 0 or amount > 30 then
		return
	end
	if source == "Stalker" and self:_isStalkerProtected(player) then return end
	local humanoid = characterHumanoid(player)
	if humanoid and humanoid.Health > 0 then
		humanoid:TakeDamage(amount)
		self:_toast(player, source .. " hit you for " .. amount .. ".")
	end
end

function ExpeditionService:OnPlayerDied(player, reason)
	if not self.active[player] then
		return
	end
	self:_eliminate(player, reason)
	if self:_activeCount() == 0 then
		self:_end("The expedition has no survivors.")
	end
end

function ExpeditionService:OnPlayerRemoving(player)
	if self.active[player] then
		self:_eliminate(player, "You disconnected and lost unbanked rewards.")
		if self:_activeCount() == 0 then
			self:_end("The expedition has no survivors.")
		end
	end
end

function ExpeditionService:_failCurrentFloor(reason)
	if self.floor then
		self.floor:Fail()
	end
	for _, player in ipairs(self:_activePlayers()) do
		self:_eliminate(player, reason)
	end
	self:_end(reason)
end

function ExpeditionService:_end(reason)
	if self.state == "Ended" or self.state == "Idle" then
		return
	end
	self._token += 1
	self._enemyService:Clear()
	if self.floor then
		self.floor:Cleanup()
		self.floor = nil
	end
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	table.clear(self.connections)
	self.state = "Ended"
	for player in pairs(self.allPlayers) do
		if player.Parent and self.active[player] then
			self:_eliminate(player, reason)
		end
	end
	self.active = {}
	if self._onFinished then
		self._onFinished(reason)
	end
end

function ExpeditionService:Destroy()
	self:_end("Server shutdown")
end

return ExpeditionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">FloorService</string>
          <string name="Source"><![CDATA[-- Authored models are immutable sources in ServerStorage. Only our Runtime
-- clones are disposable; never destroy LastStopWorld or its authored siblings.
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Pbr = require(script.Parent.PbrMaterialService)
local FloorService = {}
FloorService.__index = FloorService
local BUILD = "V5 / DEVELOPMENT"
local function need(parent, name, class)
	local child = parent:FindFirstChild(name)
	assert(child and child:IsA(class), ("[LAST STOP] Missing %s %s.%s; run node tools/build-prefabs.mjs then rojo build default.project.json."):format(class,parent:GetFullName(),name))
	return child
end
local function library() return need(ServerStorage,"LastStopAssets","Folder") end
local function clone(parent,name) return need(parent,name,"Model"):Clone() end
local function marker(model,name) return need(need(model,"Markers","Folder"),name,"BasePart") end
local function display(part,text)
	for _, v in ipairs(part:GetDescendants()) do if v:IsA("TextLabel") then v.Text=text end end
end
local function prepareDoors(model)
	local result={}
	for _, side in ipairs({"Left","Right"}) do
		local door=need(model,"Door"..side,"BasePart")
		for _, v in ipairs(door:GetDescendants()) do
			if v:IsA("BasePart") then
				v.Anchored,v.CanCollide,v.Massless=false,false,true
				local w=Instance.new("WeldConstraint")
				w.Part0,w.Part1,w.Parent=door,v,v
			end
		end
		result[side]=door
	end
	return result
end
function FloorService.new(options)
	options=options or {}
	return setmetatable({_worldName=options.WorldName or "LastStopWorld",_floorOrigin=options.FloorOrigin or Vector3.new(0,0,700),_doorTweens={},_doorGeneration=0},FloorService)
end
function FloorService:BuildWorld()
	local lobby,elevator=clone(library(),"Lobby"),clone(library(),"Elevator")
	require(script.Parent.EnvironmentService).UpgradeLobby(lobby)
	local spawn,socket=marker(lobby,"EntranceSpawn"),marker(lobby,"ElevatorSocket")
	marker(lobby,"RoomBounds")
	elevator:PivotTo(socket.CFrame)
	elevator.Name,elevator.Parent="CentralElevator",lobby
	local board,zone=marker(elevator,"EntranceSpawn"),marker(elevator,"ElevatorReturnZone")
	local doors=prepareDoors(elevator)
	local prompt=Instance.new("ProximityPrompt")
	prompt.ActionText,prompt.ObjectText="Board expedition","Deep access terminal"
	prompt.MaxActivationDistance,prompt.RequiresLineOfSight,prompt.Parent=12,true,need(lobby,"QueueConsole","BasePart")
	local world=workspace:FindFirstChild(self._worldName)
	if not world then world=Instance.new("Folder");world.Name=self._worldName;world.Parent=workspace end
	local old=world:FindFirstChild("Runtime")
	if old then old:Destroy() end
	local runtime,active=Instance.new("Folder"),Instance.new("Folder")
	runtime.Name,runtime.Parent="Runtime",world
	active.Name,active.Parent,lobby.Parent="ActiveExpedition",runtime,runtime
	lobby:SetAttribute("BuildVersion",BUILD)
	lobby:SetAttribute("SourceTemplate","ServerStorage.LastStopAssets.Lobby")
	Pbr:Apply(lobby)
	self._world,self._runtime,self._activeFolder=world,runtime,active
	self.lobby={Model=lobby,QueuePrompt=prompt,LobbySpawn=spawn.CFrame,SpawnLocation=need(lobby,"LobbySpawnPoint","SpawnLocation"),BoardCFrame=board.CFrame,
		BoardRegionCFrame=zone.CFrame,BoardRegionSize=zone.Size,Doors=doors,
		DoorClosed={Left=doors.Left.CFrame,Right=doors.Right.CFrame},
		DoorOpen={Left=doors.Left.CFrame*CFrame.new(-9.8,0,0),Right=doors.Right.CFrame*CFrame.new(9.8,0,0)},
		Display=need(elevator,"FloorDisplay","BasePart")}
	workspace:SetAttribute("LastStopBuild",BUILD)
	self:SetLobbyElevator(true,"B0 / CONCOURSE")
	print("[LAST STOP] "..BUILD.." loaded prefab Lobby + Elevator")
	return self.lobby
end
function FloorService:SetLobbyElevator(open,text)
	if not self.lobby then return end
	self._doorGeneration+=1
	local generation=self._doorGeneration
	for _, t in ipairs(self._doorTweens) do t:Cancel() end
	table.clear(self._doorTweens)
	if not open then
		local params=OverlapParams.new()
		params.FilterType,params.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{self.lobby.Model}
		local deadline=os.clock()+2
		while os.clock()<deadline do
			local blocked=false
			for _, p in ipairs(workspace:GetPartBoundsInBox(self.lobby.BoardRegionCFrame*CFrame.new(0,0,8.5),Vector3.new(19,12,2),params)) do
				if p.Parent and p.Parent:FindFirstChildOfClass("Humanoid") then blocked=true;break end
			end
			if not blocked then break end
			task.wait(.1)
			if generation~=self._doorGeneration then return end
		end
	end
	local positions=open and self.lobby.DoorOpen or self.lobby.DoorClosed
	for side,door in pairs(self.lobby.Doors) do
		door.CanCollide=false -- No crushing during a synchronized travel transition.
		local t=TweenService:Create(door,TweenInfo.new(.85,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{CFrame=positions[side]})
		table.insert(self._doorTweens,t);t:Play()
	end
	if text then display(self.lobby.Display,text) end
end
local ObjectiveRoom = require(script.Parent.ObjectiveRoom)
function FloorService:CreateRoom(definition, seed)
    return ObjectiveRoom.new(self, definition, seed)
end
return FloorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[-- Minimal vertical-slice equipment: a real togglable flashlight and one server
-- validated medkit per expedition. Broader equipment ships in Milestone B.
local InventoryService = {}
InventoryService.__index = InventoryService

local function makeFlashlight()
	local tool = Instance.new("Tool")
	tool.Name = "LastStopFlashlight"
	tool.ToolTip = "Flashlight"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 0.5, 2)
	handle.Color = Color3.fromRGB(45, 52, 58)
	handle.Material = Enum.Material.Metal
	handle.Parent = tool
	local beam = Instance.new("SpotLight")
	beam.Name = "Beam"
	beam.Enabled = false
	beam.Angle = 55
	beam.Range = 45
	beam.Brightness = 2
	beam.Color = Color3.fromRGB(210, 245, 255)
	beam.Face = Enum.NormalId.Front
	beam.Parent = handle
	tool.Activated:Connect(function()
		beam.Enabled = not beam.Enabled
	end)
	return tool
end

function InventoryService.new()
	return setmetatable({ _medkits = {} }, InventoryService)
end

function InventoryService:BeginRun(player)
	self._medkits[player] = 1
	player:SetAttribute("LastStopMedkits", 1)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack and not backpack:FindFirstChild("LastStopFlashlight") then
		makeFlashlight().Parent = backpack
	end
end

function InventoryService:UseMedkit(player, allowed)
	if not allowed(player) then
		return false, "Medkits can only be used during a floor."
	end
	if (self._medkits[player] or 0) <= 0 then
		return false, "No medkits remaining."
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or humanoid.Health >= humanoid.MaxHealth then
		return false, "You do not need a medkit yet."
	end
	self._medkits[player] -= 1
	player:SetAttribute("LastStopMedkits", self._medkits[player])
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 35)
	return true, "Medkit used."
end

function InventoryService:EndRun(player)
	self._medkits[player] = nil
	player:SetAttribute("LastStopMedkits", nil)
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		local tool = container and container:FindFirstChild("LastStopFlashlight")
		if tool then
			tool:Destroy()
		end
	end
end

return InventoryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">MatchmakingService</string>
          <string name="Source"><![CDATA[-- Server-local matchmaking for the vertical slice. It supports solo starts and
-- batches up to twelve queued players; cross-server queues belong in Milestone B.
local MatchmakingService = {}
MatchmakingService.__index = MatchmakingService

function MatchmakingService.new(config, canQueue, onStart, onToast)
	return setmetatable({
		_config = config,
		_canQueue = canQueue,
		_onStart = onStart,
		_onToast = onToast,
		_queue = {},
		_queued = {},
		_countdown = nil,
		_running = false,
		_stopped = false,
	}, MatchmakingService)
end

function MatchmakingService:IsQueued(player)
	return self._queued[player] == true
end

function MatchmakingService:RequestJoin(player)
	if self._running then
		return false, "An expedition is already running in this server. Please wait."
	end
	if not self._canQueue(player) then
		return false, "Your profile is still loading."
	end
	if self._queued[player] then
		return true, "Already queued."
	end
	self._queued[player] = true
	table.insert(self._queue, player)
	if not self._countdown then
		self._countdown = self._config.LobbyQueueCountdown
	end
	return true, "Queued for the next elevator."
end

function MatchmakingService:Remove(player)
	self._queued[player] = nil
	for index = #self._queue, 1, -1 do
		if self._queue[index] == player then
			table.remove(self._queue, index)
		end
	end
	if #self._queue == 0 then
		self._countdown = nil
	end
end

function MatchmakingService:_startQueuedGroup()
	if self._running or #self._queue == 0 then
		return
	end
	local group = {}
	while #group < self._config.MaxExpeditionPlayers and #self._queue > 0 do
		local player = table.remove(self._queue, 1)
		self._queued[player] = nil
		if player.Parent and self._canQueue(player) then
			table.insert(group, player)
		end
	end
	self._countdown = #self._queue > 0 and self._config.LobbyQueueCountdown or nil
	if #group > 0 then
		self._running = true
		self._onStart(group, function()
			self._running = false
		end)
	end
end

function MatchmakingService:Start()
	task.spawn(function()
		while not self._stopped do
			task.wait(1)
			if not self._running and self._countdown then
				self._countdown -= 1
				for player in pairs(self._queued) do
					self._onToast(player, "Elevator departs in " .. math.max(0, self._countdown) .. "s")
				end
				if self._countdown <= 0 then
					self:_startQueuedGroup()
				end
			end
		end
	end)
end

function MatchmakingService:Destroy()
	self._stopped = true
end

return MatchmakingService
]]></string>
        </Properties>
