      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">MovementService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local Movement = {}

function Movement.Start(remote, allowed)
    local requests, stamina, exhausted, lastRequest = {}, {}, {}, {}
    if not PhysicsService:IsCollisionGroupRegistered("LastStopPlayers") then PhysicsService:RegisterCollisionGroup("LastStopPlayers") end
    local function characterAdded(character)
        local function assign(part)
            if part:IsA("BasePart") then part.CollisionGroup = "LastStopPlayers" end
        end
        for _, part in character:GetDescendants() do assign(part) end
        character.DescendantAdded:Connect(assign)
    end
    local function playerAdded(player)
        player.CharacterAdded:Connect(characterAdded)
        if player.Character then characterAdded(player.Character) end
    end
    Players.PlayerAdded:Connect(playerAdded)
    for _, player in Players:GetPlayers() do playerAdded(player) end
    remote.OnServerEvent:Connect(function(player, sprinting, ...)
        if select("#", ...) ~= 0 or type(sprinting) ~= "boolean" then return end
        if sprinting and os.clock() - (lastRequest[player] or 0) < .06 then return end
        lastRequest[player] = os.clock()
        requests[player] = sprinting and allowed(player)
    end)
    local accumulator = 0
    RunService.Heartbeat:Connect(function(dt)
        accumulator += dt
        if accumulator < .1 then return end
        local step = math.min(accumulator, .3)
        accumulator = 0
        for _, player in Players:GetPlayers() do
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local active = allowed(player)
            local energy = stamina[player] or 100
            local velocity = root and root.AssemblyLinearVelocity or Vector3.zero
            local moving = Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 1.5
            local sprint = active and requests[player] and moving and not exhausted[player] and not player:GetAttribute("Carrying")
            energy = math.clamp(energy + (sprint and -24 or 16) * step, 0, 100)
            if energy <= 0 then exhausted[player] = true end
            if energy >= 30 then exhausted[player] = false end
            stamina[player] = energy
            player:SetAttribute("Stamina", math.floor(energy))
            player:SetAttribute("Sprinting", sprint == true)
            if humanoid and humanoid.Health > 0 then
                humanoid.WalkSpeed = player:GetAttribute("Carrying") and 12 or sprint and 23 or 16
            end
            if sprint then player:SetAttribute("NoiseUntil", workspace:GetServerTimeNow() + 1) end
            if not active then requests[player] = nil end
        end
    end)
    Players.PlayerRemoving:Connect(function(player)
        requests[player], stamina[player], exhausted[player], lastRequest[player] = nil, nil, nil, nil
    end)
end
return Movement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ObjectiveRoom</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Environment = require(script.Parent.EnvironmentService)
local SubwayCycle = require(game:GetService("ReplicatedStorage").Shared.Util.SubwayCycle)
local Room = {}
Room.__index = Room

function Room.new(floorService, definition, seed)
    return setmetatable({_floorService = floorService, definition = definition, seed = seed,
        connections = {}, targets = {}, progress = 0, stage = 1, destroyed = false}, Room)
end

function Room:Initialize(context) self.context = context end

function Room:_notify(player, text)
    if self.context.notify then self.context.notify(player, text) end
end

function Room:_setObjective(text)
    self.objective = text
    self.model:SetAttribute("Objective", text)
    if self.context.changed then self.context.changed(text) end
end

function Room:_target(name, position, action, caption, stage, hold)
    local cframe = self.model:GetPivot() * CFrame.new(position)
    local target = Environment.Part(self.model, name, Vector3.new(1.2, 1.2, .5), cframe,
        Color3.fromRGB(244, 174, 76), Enum.Material.Neon)
    target.CanCollide = false
    target:SetAttribute("ObjectiveKey", name)
    local light = Instance.new("PointLight")
    light.Color, light.Range, light.Brightness, light.Parent = target.Color, 9, .7, target
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText = action, caption
    prompt.HoldDuration, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = hold or 1.2, 10, true
    prompt.KeyboardKeyCode, prompt.GamepadKeyCode, prompt.Parent = Enum.KeyCode.E, Enum.KeyCode.ButtonX, target
    self.targets[name] = {part = target, prompt = prompt, stage = stage}
    local holds = {}
    table.insert(self.connections, prompt.PromptButtonHoldBegan:Connect(function(player)
        if self:_valid(player, target) then holds[player] = os.clock() end
    end))
    table.insert(self.connections, prompt.Triggered:Connect(function(player)
        local started = holds[player]
        holds[player] = nil
        if started and os.clock() - started >= prompt.HoldDuration - .15 then
            self:_attemptInteraction(player, name)
        end
    end))
    return target
end

function Room:_valid(player, target)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root or not self.context.isPlayerActive(player) or (root.Position - target.Position).Magnitude > 12 then return false end
    local parameters = RaycastParams.new()
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.RespectCanCollide = true
    local ignored = {player.Character}
    for _, teammate in Players:GetPlayers() do
        if teammate.Character then table.insert(ignored, teammate.Character) end
    end
    for _, child in self.model:GetChildren() do
        if child:GetAttribute("V4Stalker") then table.insert(ignored, child) end
    end
    parameters.FilterDescendantsInstances = ignored
    local head = player.Character:FindFirstChild("Head")
    local origin = head and head.Position or root.Position + Vector3.new(0, 1.5, 0)
    local hit = workspace:Raycast(origin, target.Position - origin, parameters)
    return not hit or hit.Instance == target
end

function Room:_carry(player, kind)
    self.carrier = player
    self.carriedKind = kind
    player:SetAttribute("Carrying", kind)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        local prop = Environment.Mesh(character, "container", root.CFrame * CFrame.new(0, -.2, -1.8), Vector3.new(1.5, 1.5, 1.5))
        prop.Name, prop.Anchored, prop.CanCollide, prop.Massless = "CarriedObjective", false, false, true
        local weld = Instance.new("WeldConstraint")
        weld.Part0, weld.Part1, weld.Parent = root, prop, prop
        self.carriedProp = prop
    end
end

function Room:_clearCarry()
    if self.carrier then self.carrier:SetAttribute("Carrying", nil) end
    if self.carriedProp then self.carriedProp:Destroy() end
    self.carrier, self.carriedProp = nil, nil
end

function Room:_advance(player, key)
    self.progress += 1
    self.stage += 1
    for _, entry in self.targets do
        entry.prompt.Enabled = entry.stage == self.stage
        entry.part.Transparency = entry.stage < self.stage and .8 or 0
    end
    self:_setObjective(self.instructions[self.stage] or "Return to the elevator. Stay together.")
    self.context.onObjectiveStep(player, key)
end

function Room:_attemptInteraction(player, key)
    local entry = self.targets[key]
    if self.destroyed or self.completed or not entry or entry.stage ~= self.stage or not entry.prompt.Enabled then return false end
    if not self:_valid(player, entry.part) then return false end
    if key == "ControlA" or key == "ControlB" then
        local now = os.clock()
        self.controls[key] = {player = player, time = now}
        local other = self.controls[key == "ControlA" and "ControlB" or "ControlA"]
        local activeCount = #self.context.getActivePlayers()
        local window = activeCount > 1 and 10 or 22
        if not other or not self.context.isPlayerActive(other.player) or now - other.time > window then
            self:_notify(player, activeCount > 1 and "Signal held for 10 seconds. A teammate must operate the other control." or "Signal held for 22 seconds. Reach the other control.")
            entry.part.Color = Color3.fromRGB(92, 210, 202)
            return true
        end
        if activeCount > 1 and other.player == player then
            self:_notify(player, "Two operators required. Ask a teammate to use the other control.")
            return false
        end
        self:_advance(player, "SynchronizedControls")
    elseif key == "Fuse" or key == "Sample" then
        local kind = self.definition.Template == "Hospital" and "Archive case" or self.definition.Template == "AbandonedSubway" and "Relay case" or "Sealed sample"
        self:_carry(player, key == "Fuse" and "Power cell" or kind)
        self:_advance(player, key)
    elseif key == "Power" or key == "Delivery" then
        if self.carrier ~= player then
            self:_notify(player, "The teammate carrying the case must deliver it here.")
            return false
        end
        self:_clearCarry()
        self:_advance(player, key)
    else
        self:_advance(player, key)
    end
    return true
end

function Room:Start()
    local assets = game:GetService("ServerStorage").LastStopAssets
    local laboratory = self.definition.Template == "FloodedLaboratory"
    local subway = self.definition.Template == "AbandonedSubway"
    if subway then
        self.model = Environment.BuildSubway()
    elseif laboratory then
        self.model = Environment.BuildLaboratory()
    else
        self.model = Environment.UpgradeHospital(assets.Floors.Hospital:Clone())
    end
    self.model:PivotTo(CFrame.new(self._floorService._floorOrigin))
    self.model.Name = self.definition.Template
    self.model:SetAttribute("SourceTemplate", "ServerStorage.LastStopAssets / " .. self.definition.Template)
    self.model:SetAttribute("FloorTheme", subway and "Subway" or laboratory and "Laboratory" or "Hospital")
    self.model:SetAttribute("HazardPhase", "Safe")
    self.model.Parent = self._floorService._activeFolder
    local markers = self.model.Markers
    self.spawnCFrame = markers.EntranceSpawn.CFrame
    self.escapeCFrame, self.escapeSize = markers.ElevatorReturnZone.CFrame, markers.ElevatorReturnZone.Size
    local elevator = assets.Elevator:Clone()
    elevator:PivotTo(markers.ElevatorSocket.CFrame)
    elevator.Name, elevator.Parent = "ReturnElevator", self.model
    for _, side in {"Left", "Right"} do
        local door = elevator["Door" .. side]
        local shift = CFrame.new(side == "Left" and -9.8 or 9.8, 0, 0)
        door.CFrame *= shift
        for _, part in door:GetDescendants() do
            if part:IsA("BasePart") then part.CFrame *= shift end
        end
    end
    self.patrolPoints = {markers.EnemySpawn.Position}
    self.hazardMode = subway and "Train" or laboratory and "Flood" or "Discharge"
    for _, point in markers.PatrolPaths:GetChildren() do table.insert(self.patrolPoints, point.Position) end
    self.controls = {}
    if subway then
        self.instructions = {"Take the signal relay from the north platform console.",
            "Install the relay at the south signal box. Watch the track: the last train passes on a timer.",
            "Synchronize signal controls A + B. Two players have 10 seconds. Solo has 22 seconds.",
        "Recover the relay case from the north east platform.", "Carry the case to the elevator receiver. Stay off the track during a train pass."}
        self:_target("Fuse", Vector3.new(-22, 3.4, -52), "Take relay", "NORTH PLATFORM / RELAY", 1)
        self:_target("Power", Vector3.new(-22, 3.4, 40), "Install relay", "SOUTH SIGNAL BOX", 2, 2)
        self:_target("ControlA", Vector3.new(-24, 3.4, 8), "Hold signal", "PLATFORM / CONTROL A", 3, 1)
        self:_target("ControlB", Vector3.new(24, 3.4, -8), "Hold signal", "EAST / CONTROL B", 3, 1)
        self:_target("Sample", Vector3.new(22, 3.4, -40), "Recover relay case", "NORTH PLATFORM / RELAY CASE", 4, 2)
        self:_target("Delivery", Vector3.new(4, 3, 56), "Deliver relay", "ELEVATOR RECEIVER", 5, 2)
    elseif laboratory then
        local westFirst = self.seed % 2 == 0
        self.instructions = {westFirst and "Restart pump A on the west catwalk." or "Restart pump B on the east catwalk.",
            westFirst and "Restart pump B on the east catwalk." or "Restart pump A on the west catwalk.",
            "Synchronize controls A + B. Two players have 10 seconds. Solo has 22 seconds.",
            "Retrieve the sealed specimen at the north terminal.", "Carry the specimen to the elevator receiver. You move more slowly."}
        self:_target("PumpA", Vector3.new(-37, 3, 38), "Restart pump", "WEST / PUMP A", westFirst and 1 or 2, 3)
        self:_target("PumpB", Vector3.new(37, 3, 38), "Restart pump", "EAST / PUMP B", westFirst and 2 or 1, 3)
        self:_target("ControlA", Vector3.new(-9, 3, 0), "Hold signal", "CONTROL A", 3, 1)
        self:_target("ControlB", Vector3.new(9, 3, 0), "Hold signal", "CONTROL B", 3, 1)
        -- Route variant: the seed also picks which north terminal holds the specimen.
        local specimenX = self.seed % 2 == 0 and -12 or 12
        self:_target("Sample", Vector3.new(specimenX, 4.8, -43), "Secure specimen", "SEALED SPECIMEN", 4, 2)
        self:_target("Delivery", Vector3.new(4, 3, 46), "Deliver specimen", "ELEVATOR RECEIVER", 5, 2)
    else
        local old = self.model:FindFirstChild("ObjectiveSockets")
        if old then old:Destroy() end
        -- Route variant: the seed chooses the ward route (west) or the service corridor (east).
        -- Both lead to the same imaging panel, so the objective count is unchanged.
        local serviceRoute = self.seed % 2 == 1
        self.instructions = {serviceRoute and "Take the emergency power cell from the east service corridor." or "Find the emergency power cell in the west ward.",
            "Carry the power cell to the imaging distribution panel.",
            "Synchronize ward and imaging controls. Use separate operators in a team.",
            "Recover the quarantined archive case.", "Carry the archive case back to the elevator receiver."}
        self:_target("Fuse", serviceRoute and Vector3.new(19, 3.1, -1) or Vector3.new(-29, 3.1, -1), serviceRoute and "Take power cell" or "Take power cell", serviceRoute and "SERVICE CORRIDOR / POWER" or "WEST WARD / POWER", 1)
        self:_target("Power", Vector3.new(29, 4.2, 17), "Install power cell", "IMAGING / POWER", 2, 2)
        self:_target("ControlA", Vector3.new(-13, 3, 5), "Hold signal", "WARD / CONTROL A", 3, 1)
        self:_target("ControlB", Vector3.new(13, 3, 9), "Hold signal", "IMAGING / CONTROL B", 3, 1)
        self:_target("Sample", Vector3.new(25, 4.1, -23), "Recover archive case", "QUARANTINED ARCHIVE", 4, 2)
        self:_target("Delivery", Vector3.new(4, 3, 28), "Deliver archive", "ELEVATOR RECEIVER", 5, 2)
    end
    for _, entry in self.targets do entry.prompt.Enabled = entry.stage == self.stage end
    -- Hidden loot: one seed-placed side stash per run. It is server-side only and
    -- adds a small bonus to the unbanked pot (never client-supplied).
    local stashRandom = Random.new(self.seed + 977)
    local stashPositions = subway and {Vector3.new(-22, 3, -30), Vector3.new(22, 3, 30)}
        or laboratory and {Vector3.new(-37, 3, 30), Vector3.new(37, 3, 30)}
        or {Vector3.new(-30, 3, 20), Vector3.new(30, 3, -20)}
    self.stashPosition = stashPositions[stashRandom:NextInteger(1, #stashPositions)]
    self.stashFound = false
    local stash = Instance.new("Part")
    stash.Name, stash.Anchored, stash.CanCollide = "HiddenStash", true, false
    stash.Size, stash.CFrame, stash.Transparency = Vector3.new(2, 1.2, 2), self.model:GetPivot() * CFrame.new(self.stashPosition), 1
    stash.Parent = self.model
    local stashPrompt = Instance.new("ProximityPrompt")
    stashPrompt.ActionText, stashPrompt.ObjectText = "Search stash", "Hidden stash"
    stashPrompt.HoldDuration, stashPrompt.MaxActivationDistance = 1, 10
    stashPrompt.Parent = stash
    local stashHolds = {}
    table.insert(self.connections, stashPrompt.PromptButtonHoldBegan:Connect(function(player)
        if self:_valid(player, stash) then stashHolds[player] = os.clock() end
    end))
    table.insert(self.connections, stashPrompt.Triggered:Connect(function(player)
        local began = stashHolds[player]
        stashHolds[player] = nil
        if self.destroyed or self.completed or self.stashFound or not began
            or os.clock() - began < stashPrompt.HoldDuration - .15 or not self:_valid(player, stash) then return end
        self.stashFound = true
        stash:Destroy()
        self.context.onHiddenLoot(player)
    end))
    self:_setObjective(self.instructions[1])
    self.startedAt = os.clock()
    task.spawn(function() self:_hazards(self.hazardMode) end)
end

function Room:_hazards(mode)
    local lastDamage = {}
    local trainHitPass = {}
    local previousTrainZ
    local laboratory = mode == "Flood"
    local subway = mode == "Train"
    while not self.destroyed and self.model and not self.completed do
        local elapsed = os.clock() - self.startedAt
        -- The train pass runs on its own, shorter cycle than the discharge cycle.
        local phase, cycle
        if subway then
            phase, cycle = SubwayCycle.Phase(elapsed, self.seed % 7)
        else
            cycle = (elapsed + self.seed % 7) % 18
            phase = cycle > 14 and "Active" or cycle > 10 and "Warning" or "Safe"
        end
        self.model:SetAttribute("HazardPhase", phase)
        local trainPass = math.floor((elapsed + self.seed % 7) / SubwayCycle.Period)
        -- Random event: a seed-timed power flicker (lighting only, never damage).
        -- It holds for 1.6 s so clients can see it, not just a single tick.
        local flickerSlot = math.floor(elapsed / 1.6)
        local flicker = (flickerSlot + self.seed) % 37 == 0 and phase == "Safe"
        self.model:SetAttribute("PowerFlicker", flicker)
        local train = subway and self.model:FindFirstChild("Train")
        if train then
            -- Move the visible train on the same tick that sets its warning and damage lane.
            -- Pivot relative to its authored home so the offset never compounds.
            local trainZ = SubwayCycle.TrainZ(cycle, phase)
            self.model:SetAttribute("TrainZ", trainZ)
            self.trainHome = self.trainHome or train:GetPivot()
            train:PivotTo(self.trainHome * CFrame.new(0, 0, trainZ - (-86)))
        end
        local water = self.model:FindFirstChild("FloodWater")
        if water then
            water.Color = phase == "Active" and Color3.fromRGB(48, 110, 122) or Color3.fromRGB(32, 87, 95)
            water.Material = Enum.Material.Glass
        end
        for _, player in self.context.getActivePlayers() do
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if self.carrier == player and (not root or not self.context.isPlayerActive(player)) then
                self:_clearCarry()
                -- Re-open the pickup after death/disconnect without resetting earned milestones.
                self.stage = self.stage - 1
                self.progress = self.progress - 1
                for _, entry in self.targets do entry.prompt.Enabled = entry.stage == self.stage end
                self:_setObjective(self.instructions[self.stage])
            end
            if root and phase == "Active" and os.clock() - (lastDamage[player] or 0) > 1.2 then
                local localPosition = self.model:GetPivot():PointToObjectSpace(root.Position)
                local exposed
                if laboratory then
                    exposed = localPosition.Y < 1.8
                elseif subway then
                    -- The train occupies the track lane only while Active, and
                    -- is in the track bed behind the centre line.
                    exposed = trainHitPass[player] ~= trainPass
                        and SubwayCycle.Exposed(localPosition, self.model:GetAttribute("TrainZ") or -200, previousTrainZ)
                else
                    exposed = math.abs(localPosition.X) < 5 and localPosition.Z < 0 and localPosition.Z > -24
                end
                if exposed then
                    lastDamage[player] = os.clock()
                    if subway then trainHitPass[player] = trainPass end
                    local source = laboratory and "Electrified floodwater" or subway and "Passing train" or "Containment discharge"
                    self.context.damagePlayer(player, subway and SubwayCycle.Damage or 8, source)
                end
            end
        end
        -- A disconnected carrier is absent from the active-player iteration.
        if self.carrier and not self.context.isPlayerActive(self.carrier) then
            self:_clearCarry()
            self.stage -= 1
            self.progress -= 1
            for _, entry in self.targets do entry.prompt.Enabled = entry.stage == self.stage end
            self:_setObjective(self.instructions[self.stage])
        end
        previousTrainZ = phase == "Active" and self.model:GetAttribute("TrainZ") or nil
        task.wait(.25)
    end
end

function Room:ObjectiveProgress() return self.progress, self.definition.Target end
function Room:Complete() self.completed = true; self.model:SetAttribute("Complete", true); self:_clearCarry() end
function Room:Fail() self.completed = true; self.model:SetAttribute("Failed", true); self:_clearCarry() end
function Room:Cleanup()
    self.destroyed = true
    self:_clearCarry()
    for _, connection in self.connections do connection:Disconnect() end
    table.clear(self.connections)
    if self.model then self.model:Destroy(); self.model = nil end
    table.clear(self.targets)
end

return Room
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">PbrMaterialService</string>
          <string name="Source"><![CDATA[-- MaterialVariants are authored in default.project.json. BaseMaterial and map
-- properties require Studio/plugin capability and must never be written by a
-- live server script. Runtime only assigns the saved variant to cloned parts.
local MaterialService = game:GetService("MaterialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ArtTheme = require(ReplicatedStorage.Shared.ArtTheme)

local PbrMaterialService = {}

local function validContentId(value)
	return typeof(value) == "string" and value ~= ""
end

local function isComplete(definition)
	return definition
		and validContentId(definition.ColorMap)
		and validContentId(definition.NormalMap)
		and validContentId(definition.RoughnessMap)
		and validContentId(definition.MetalnessMap)
end

function PbrMaterialService:Configure()
	local configured = {}
	for name, definition in pairs(ArtTheme.Pbr) do
		if isComplete(definition) then
			local variant = MaterialService:FindFirstChild(name)
			assert(variant and variant:IsA("MaterialVariant"),
				("[LAST STOP] Missing saved MaterialService.%s; rebuild default.project.json"):format(name))
			-- Map reads are also Plugin-protected. The offline build audit checks IDs.
			configured[name] = true
		end
	end
	return configured
end

function PbrMaterialService:Apply(root)
	local configured = self:Configure()
	if not next(configured) then
		return false
	end

	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local tag = descendant:FindFirstChild("PbrMaterial")
			local materialName = descendant:GetAttribute("PbrMaterial") or (tag and tag.Value)
			local definition = materialName and ArtTheme.Pbr[materialName]
			if definition and configured[materialName] then
				descendant.Material = definition.BaseMaterial
				descendant.MaterialVariant = materialName
			end
		end
	end

	return true
end

return PbrMaterialService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source"><![CDATA[-- Persistent, server-owned player profile service. DataStore failures degrade to a
-- session profile; no client-supplied balance is ever accepted.
local DataStoreService = game:GetService("DataStoreService")

local ProfileService = {}
ProfileService.__index = ProfileService

local function defaultProfile(config)
	return {
		Version = config.Version,
		Coins = config.StarterCoins,
		XP = config.StarterXP,
		Level = 1,
		Equipment = { Flashlight = true, Scanner = true, Medkit = 1 },
		Stats = { Escapes = 0, BestDepth = 0, FirstEscapeClaimed = false },
	}
end

local function normalise(saved, config)
	local profile = defaultProfile(config)
	if type(saved) ~= "table" then
		return profile
	end
	profile.Version = math.max(tonumber(saved.Version) or 1, 1)
	profile.Coins = math.max(0, math.floor(tonumber(saved.Coins) or 0))
	profile.XP = math.max(0, math.floor(tonumber(saved.XP) or 0))
	profile.Level = math.max(1, math.floor(tonumber(saved.Level) or 1))
	if type(saved.Equipment) == "table" then
		profile.Equipment = saved.Equipment
	end
	if type(saved.Stats) == "table" then
		for key, value in pairs(saved.Stats) do
			if type(value) == "boolean" or type(value) == "number" then
				profile.Stats[key] = value
			end
		end
	end
	return profile
end

function ProfileService.new(config)
	local store
	local storeAvailable, storeError = pcall(function()
		store = DataStoreService:GetDataStore(config.ProfileStoreName)
	end)
	if not storeAvailable then
		warn("[ProfileService] DataStore unavailable; using session-only profiles:", storeError)
	end
	return setmetatable({
		_config = config,
		_store = store,
		_storeAvailable = storeAvailable,
		_profiles = {},
		_dirty = {},
	}, ProfileService)
end

function ProfileService:Load(player)
	local key = "p_" .. player.UserId
	local loaded
	local ok, err = self._storeAvailable, "DataStore unavailable"
	if self._storeAvailable then
		ok, err = pcall(function()
			loaded = self._store:GetAsync(key)
		end)
	end
	if not ok then
		warn("[ProfileService] load failed for", player.UserId, err)
	end
	local profile = normalise(loaded, self._config)
	self._profiles[player] = profile
	self._dirty[player] = not ok
	return profile
end

function ProfileService:Get(player)
	return self._profiles[player]
end

function ProfileService:Mutate(player, callback)
	local profile = self._profiles[player]
	if not profile then
		return false, "Profile not loaded"
	end
	callback(profile)
	self._dirty[player] = true
	return true, profile
end

function ProfileService:Save(player)
	local profile = self._profiles[player]
	if not profile or not self._dirty[player] then
		return true
	end
	if not self._storeAvailable then
		return false, "DataStore unavailable"
	end
	local key = "p_" .. player.UserId
	local snapshot = profile
	local ok, err = pcall(function()
		self._store:UpdateAsync(key, function()
			return snapshot
		end)
	end)
	if ok then
		self._dirty[player] = false
	else
		warn("[ProfileService] save failed for", player.UserId, err)
	end
	return ok, err
end

function ProfileService:Release(player)
	self:Save(player)
	self._profiles[player] = nil
	self._dirty[player] = nil
end

function ProfileService:SaveAll()
	for player in pairs(self._profiles) do
		self:Save(player)
	end
end

return ProfileService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="37">
      <Properties>
        <string name="Name">TestRunner</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Runs pure deterministic smoke tests in Studio Play mode. It is deliberately
-- skipped in published servers so it cannot affect live performance.
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end

local spec = require(script.Parent.Tests.VerticalSliceSpec)
local ok, err = pcall(function()
	spec()
	require(script.Parent.Tests.SubwayCycleSpec)()
	require(script.Parent.Tests.RouteVariantSpec)()
	require(script.Parent.Tests.InteractionOcclusionSpec)()
	require(script.Parent.Tests.FloorTimerSpec)()
	require(script.Parent.Tests.PrefabLifecycleSpec)()
end)
if not ok then
	error("[LAST STOP] Vertical-slice tests failed: " .. tostring(err))
end
print("[LAST STOP] Vertical-slice pure logic tests passed.")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="38">
      <Properties>
        <string name="Name">Tests</string>
      </Properties>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">FloorTimerSpec</string>
          <string name="Source"><![CDATA[-- A completed floor's delayed work must never affect a later CONTINUE floor.
return function()
    local Expedition = require(script.Parent.Parent.Services.ExpeditionService)
    local config = table.clone(require(game.ReplicatedStorage.Shared.Config.GameConfig))
    config.TravelSeconds, config.FloorTimeLimitSeconds = 0, .3
    local floors = {}
    function floors:CreateRoom()
        return {Initialize = function() end, Start = function() end,
            spawnCFrame = CFrame.new(), patrolPoints = {Vector3.zero}}
    end
    local expedition = Expedition.new(config, floors, {}, {}, {}, {}, {})
    expedition.active = {[{Parent = true}] = true}
    expedition._token, expedition.state, expedition.seed = 1, "Travel", 1
    expedition._broadcast, expedition._movePlayer = function() end, function() end
    expedition._chooseFloor = function() return {Id = "TimerFixture", Target = 1} end
    local failures = 0
    expedition._failCurrentFloor = function() failures += 1 end
    expedition:_beginNextFloor(1)
    task.wait(.1)
    expedition.floor = {} -- The first floor was cleaned up during CONTINUE.
    task.wait(.35)
    expedition._token += 1
    assert(failures == 0, "Previous floor timeout sealed a later floor")
    expedition:_beginNextFloor(2)
    task.wait(.4)
    expedition._token += 1 -- Cancel deferred Stalker callbacks owned by the fixture.
    assert(failures == 1, "Current floor timeout did not run")
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">GameplayRecoverySpec</string>
          <string name="Source"><![CDATA[-- Explicit Studio QA. Uses the authored rooms and live navigation/physics.
-- Run asynchronously from MCP or the server Command Bar. No profile writes.
return function()
    assert(game:GetService("RunService"):IsStudio(), "Studio QA only")
    local services = script.Parent.Parent.Services
    local floors = require(services.FloorService).new({WorldName = "LastStopV5RecoveryQA", FloorOrigin = Vector3.new(3200, 0, 700)})
    local definitions = require(game.ReplicatedStorage.Shared.Config.FloorConfig).Floors
    local navigation = game:GetService("PathfindingService")
    local report = {routes = {}, extractionRoutes = {}, patrol = {}}
    local enemies = require(services.EnemyService).new()
    local room
    local ok, err = xpcall(function()
        floors:BuildWorld()
        for _, definition in definitions do
            room = floors:CreateRoom(definition, 42)
            room:Initialize({getActivePlayers = function() return {} end, isPlayerActive = function() return false end})
            room:Start()
            task.wait(1)
            local socket = room.model.Markers.ElevatorSocket.Position
            local doorway = room.model.ReturnElevator.Threshold.Position
            assert((doorway - socket).Unit:Dot((room.spawnCFrame.Position - socket).Unit) > .5,
                definition.Id .. " elevator faces away from the playable room")
            local excluded = {room.model.Markers}
            for _, entry in room.targets do table.insert(excluded, entry.part) end
            local train = room.model:FindFirstChild("Train")
            if train then
                table.insert(excluded, train)
                for _, part in train:GetDescendants() do
                    if part:IsA("BasePart") then assert(not part.CanCollide, "Train collision can fling players") end
                end
            end
            local params = RaycastParams.new()
            params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, excluded
            params.RespectCanCollide = true
            for key, entry in room.targets do
                local reachable
                for _, offset in {Vector3.new(0, 0, 4), Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0), Vector3.new(0, 0, -4)} do
                    local candidate = entry.part.Position + offset
                    local hit = workspace:Raycast(candidate + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), params)
                    if hit and hit.Instance.CanCollide and math.abs(hit.Position.Y - entry.part.Position.Y) < 7 then
                        local stand = hit.Position + Vector3.new(0, 3, 0)
                        local path = navigation:CreatePath({AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = true})
                        path:ComputeAsync(room.spawnCFrame.Position, stand)
                        local points = path:GetWaypoints()
                        local endpoint = points[#points]
                        if path.Status == Enum.PathStatus.Success and endpoint and (endpoint.Position - stand).Magnitude < 4 then
                            reachable = {floor = definition.Id, key = key, ground = hit.Instance.Name, endpointDistance = (endpoint.Position - stand).Magnitude, waypoints = #points}
                        end
                        path:Destroy()
                        if reachable then break end
                    end
                    task.wait()
                end
                assert(reachable, definition.Id .. " has no grounded route to " .. key)
                table.insert(report.routes, reachable)
            end
            local extraction = navigation:CreatePath({AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = true})
            extraction:ComputeAsync(room.spawnCFrame.Position, room.escapeCFrame.Position)
            local points = extraction:GetWaypoints()
            local endpoint = points[#points]
            assert(extraction.Status == Enum.PathStatus.Success and endpoint, definition.Id .. " extraction route blocked")
            local delta = endpoint.Position - room.escapeCFrame.Position
            assert(Vector3.new(delta.X, 0, delta.Z).Magnitude < 3, "Navigation projected outside the elevator")
            table.insert(report.extractionRoutes, {floor = definition.Id, waypoints = #points})
            extraction:Destroy()
            room:Cleanup()
            room = nil
        end
        room = floors:CreateRoom(definitions[1], 44)
        room:Initialize({getActivePlayers = function() return {} end, isPlayerActive = function() return false end})
        room:Start()
        local stalker = enemies:SpawnStalker(room.model, room.patrolPoints, {getActivePlayers = function() return {} end})
        stalker.random = Random.new(3)
        enemies:Start()
        local start = stalker.root.Position
        local maximumDistance, listeningSamples = 0, 0
        for index = 1, 120 do
            task.wait(.5)
            maximumDistance = math.max(maximumDistance, (stalker.root.Position - start).Magnitude)
            if stalker.state == "Lurk" then
                listeningSamples += 1
                assert(stalker.stuckTime == 0 and stalker.waypoints == nil, "Listening triggered movement/stuck recovery")
            end
            table.insert(report.patrol, {t = index * .5, state = stalker.state, position = tostring(stalker.root.Position), stuck = stalker.stuckTime})
        end
        assert(maximumDistance > 20, "Patrol failed to move through the room")
        assert(listeningSamples > 0, "Listening regression was not exercised")
        report.maximumPatrolDistance, report.listeningSamples = maximumDistance, listeningSamples
    end, debug.traceback)
    enemies:Destroy()
    if room then room:Cleanup() end
    local world = workspace:FindFirstChild("LastStopV5RecoveryQA")
    if world then world:Destroy() end
    report.pass, report.error = ok, not ok and err or nil
    print("[LAST STOP V5] Gameplay recovery QA", ok and "PASS" or err)
    return report
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">InteractionOcclusionSpec</string>
          <string name="Source"><![CDATA[-- Invisible enemy collision bodies must not silently reject objective holds.
return function()
    local Room = require(script.Parent.Parent.Services.ObjectiveRoom)
    local model = Instance.new("Model", workspace)
    model.Name = "LastStopInteractionOcclusionQA"
    local origin = Vector3.new(5000, 100, 0)
    local function part(parent, name, position, size)
        local item = Instance.new("Part")
        item.Name, item.Anchored, item.Position, item.Size = name, true, origin + position, size
        item.Parent = parent
        return item
    end
    local character = Instance.new("Model", model)
    part(character, "HumanoidRootPart", Vector3.new(0, 3, 0), Vector3.one)
    part(character, "Head", Vector3.new(0, 4.5, 0), Vector3.one)
    local enemy = Instance.new("Model", model)
    enemy:SetAttribute("V4Stalker", true)
    local torso = part(enemy, "Torso", Vector3.new(4, 3.75, 0), Vector3.new(2, 4, 4))
    torso.Transparency = 1
    local target = part(model, "Objective", Vector3.new(8, 3, 0), Vector3.one)
    target.CanCollide = false
    local room = Room.new({}, {}, 1)
    room.model, room.context = model, {isPlayerActive = function() return true end}
    local player = {Character = character}
    local ok, err = pcall(function()
        assert(room:_valid(player, target), "Invisible enemy collider blocked a valid hold")
        part(model, "Wall", Vector3.new(4, 3.75, 0), Vector3.new(.5, 8, 8))
        assert(not room:_valid(player, target), "Wall line-of-sight check was bypassed")
        character.HumanoidRootPart.Position = origin + Vector3.new(-20, 3, 0)
        assert(not room:_valid(player, target), "Interaction distance check was bypassed")
    end)
    model:Destroy()
    assert(ok, err)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">PrefabLifecycleSpec</string>
          <string name="Source"><![CDATA[-- Studio integration test: real Instances, two clean room cycles and a world
-- rebuild. Sources and sibling authored art must survive every cycle.
return function()
	local storage=game:GetService("ServerStorage")
	local FloorService=require(script.Parent.Parent.Services.FloorService)
	local definition=require(game.ReplicatedStorage.Shared.Config.FloorConfig).Floors[1]
	local assets=storage:WaitForChild("LastStopAssets")
	local before={}
	for _, template in ipairs({assets.Lobby,assets.Elevator,assets.Floors.Hospital,assets.Stalker}) do before[template]=#template:GetDescendants() end
	local world=Instance.new("Folder")
	world.Name="LastStopPrefabLifecycleTest";world.Parent=workspace
	local sentinel=Instance.new("Folder")
	sentinel.Name="AuthoredSiblingMustSurvive";sentinel.Parent=world
	local floors=FloorService.new({WorldName=world.Name,FloorOrigin=Vector3.new(1500,0,700)})
	local ok,err=xpcall(function()
		for run=1,2 do
			local lobby=floors:BuildWorld()
			assert(lobby.Model~=assets.Lobby and lobby.Model:GetAttribute("SourceTemplate"),"Lobby must be a tagged clone")
			assert(lobby.SpawnLocation:IsA("SpawnLocation"),"Engine spawn must target the concourse")
			assert(sentinel.Parent==world,"BuildWorld deleted authored sibling art")
			local room=floors:CreateRoom(definition,run)
			room:Initialize({getActivePlayers=function() return {} end,interactionDistance=12,isPlayerActive=function() return false end,onObjectiveStep=function() error("No simulated players should interact") end})
			room:Start()
			assert(room.model~=assets.Floors.Hospital and room.model:GetAttribute("SourceTemplate"),"Hospital must clone the authored model")
			assert(room.model.Rooms:FindFirstChild("PatientWard") and room.model.Rooms:FindFirstChild("Archive"),"Hospital spaces missing")
			assert(#room.patrolPoints>=5 and room.escapeSize.X==18,"Hospital markers were not bound")
            -- Both seeded power-cell positions must be clear of privacy curtains
            -- for a player's head ray and the third-person prompt camera ray.
            for _, x in {-29, -19} do
                local target = room.model:GetPivot():PointToWorldSpace(Vector3.new(x, 3.1, -1))
                for _, offset in {Vector3.new(0, 1.4, 3), Vector3.new(0, 1.5, 5)} do
                    local hit = workspace:Raycast(target + offset, -offset)
                    assert(not hit or hit.Instance:GetAttribute("ObjectiveKey") == "Fuse",
                        "Power-cell approach obstructed at " .. x .. " by " .. (hit and hit.Instance.Name or "unknown"))
                end
            end
            local progress,total=room:ObjectiveProgress()
			assert(progress==0 and total==5,"A new round must reset objectives")
			local clone=room.model
			room:Cleanup()
			assert(clone.Parent==nil and next(room.targets)==nil,"Round cleanup must remove only the active clone")
			for template,count in pairs(before) do assert(template:IsDescendantOf(storage) and #template:GetDescendants()==count,"Source prefab mutated or deleted") end
		end
	end,debug.traceback)
	world:Destroy()
	assert(ok,err)
	print("[LAST STOP] Prefab lifecycle PASS: two rounds, objective reset, source preservation, authored sibling preservation")
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">RouteVariantSpec</string>
          <string name="Source"><![CDATA[return function()
	-- These check the exact rules ObjectiveRoom uses for route variants and the power flicker.
	-- They test the formulas, not a live floor instance; a live floor is covered by the Studio
	-- playtest checklist (NOT TESTED here).

	-- Hospital route: the seed picks the ward (west) or service corridor (east) route.
	local function hospitalFuseX(seed)
		return (seed % 2 == 1) and 19 or -29
	end
	assert(hospitalFuseX(1) == 19, "Odd seed must take the service corridor route")
	assert(hospitalFuseX(2) == -29, "Even seed must take the ward route")
	-- Both routes end at the same imaging panel, so the objective count never changes.
	for seed = 1, 20 do
		assert(hospitalFuseX(seed) == 19 or hospitalFuseX(seed) == -29, "Hospital route must be one of two fixed options")
	end

	-- Laboratory route: the seed picks which north terminal holds the specimen.
	local function labSpecimenX(seed)
		return (seed % 2 == 0) and -12 or 12
	end
	assert(labSpecimenX(2) == -12, "Even seed must place the specimen on the west terminal")
	assert(labSpecimenX(3) == 12, "Odd seed must place the specimen on the east terminal")

	-- Power flicker: holds for a 1.6 s slot, fires only in Safe, and is rare (about 1 in 37 slots).
	local function flickerAt(elapsed, seed, phase)
		local slot = math.floor(elapsed / 1.6)
		return (slot + seed) % 37 == 0 and phase == "Safe"
	end
	-- The same slot holds for its whole duration, so a client can see it.
	assert(flickerAt(0.0, 0, "Safe") == flickerAt(1.5, 0, "Safe"), "Flicker must hold across its slot")
	-- It never fires during a train pass or discharge.
	assert(flickerAt(0.0, 0, "Warning") == false, "Flicker must not fire during warning")
	assert(flickerAt(0.0, 0, "Active") == false, "Flicker must not fire during an active pass")
	-- Over a long run it fires, and not on every slot.
	local fired, slots = 0, 0
	for slot = 0, 369 do
		slots += 1
		if flickerAt(slot * 1.6, 0, "Safe") then fired += 1 end
	end
	assert(fired > 0 and fired < slots, "Flicker must occur occasionally, not constantly")
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">SubwayCycleSpec</string>
          <string name="Source"><![CDATA[return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local SubwayCycle = require(ReplicatedStorage.Shared.Util.SubwayCycle)

	-- Four seconds of warning precede each four-second pass.
	local phase = SubwayCycle.Phase(0, 0)
	assert(phase == "Safe", "Cycle start must be Safe")
	assert(select(1, SubwayCycle.Phase(10, 0)) == "Warning", "Expected Warning at 10 s")
	assert(select(1, SubwayCycle.Phase(13, 0)) == "Active", "Expected Active at 13 s")
	assert(select(1, SubwayCycle.Phase(16, 0)) == "Safe", "Cycle must wrap at the period")

	-- The per-run offset shifts the schedule but keeps the same period.
	assert(select(1, SubwayCycle.Phase(13, 4)) == "Safe", "Offset must shift the active window")

	-- Only an Active train has a track position; otherwise it is parked far away.
	assert(SubwayCycle.TrainZ(13, "Active") == -32, "Train should be on the track while Active")
	assert(SubwayCycle.TrainZ(5, "Safe") == -200, "Parked train must be off the track")

	-- Exposure: inside the lane and near the train's Z only.
	assert(SubwayCycle.Exposed(Vector3.new(0, 0, -32), -32), "Player in the lane under the train must be exposed")
	assert(not SubwayCycle.Exposed(Vector3.new(20, 0, -32), -32), "Player beside the lane must be safe")
	assert(not SubwayCycle.Exposed(Vector3.new(0, 0, 40), -32), "Player far down the track must be safe")
	assert(SubwayCycle.Exposed(Vector3.new(0, 3, -12), -32), "Full car length must damage")
	assert(SubwayCycle.Exposed(Vector3.new(0, 3, -60), -32, -50), "Swept train movement must not tunnel")
	assert(not SubwayCycle.Exposed(Vector3.new(0, 12, -32), -32), "Above the train must be safe")
	assert(not SubwayCycle.Exposed(Vector3.new(0, -12, -32), -32), "Below the train must be safe")
	assert(SubwayCycle.ActiveStart - SubwayCycle.WarningStart >= 4, "Warning is too short")
	assert(SubwayCycle.Damage == 25, "Train damage balance changed")

	-- Stalker patrol choice: the next waypoint is always different from the current one.
	local seeded = Random.new(7)
	for _ = 1, 200 do
		local current = seeded:NextInteger(1, 4)
		local next = SubwayCycle.PickPatrolIndex(seeded, 4, current)
		assert(next >= 1 and next <= 4, "Patrol index out of range")
		assert(next ~= current, "Stalker must pick a different waypoint")
	end
	assert(SubwayCycle.PickPatrolIndex(seeded, 1, 1) == 1, "Single waypoint must return 1")
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">TrainHazardSpec</string>
          <string name="Source"><![CDATA[-- Explicit Studio fixture for the real room hazard loop, without profile writes.
return function()
    assert(game:GetService("RunService"):IsStudio(), "Studio QA only")
    local services = script.Parent.Parent.Services
    local floors = require(services.FloorService).new({WorldName = "LastStopTrainQA", FloorOrigin = Vector3.new(4200, 0, 700)})
    floors:BuildWorld()
    local definition
    for _, item in require(game.ReplicatedStorage.Shared.Config.FloorConfig).Floors do
        if item.Template == "AbandonedSubway" then definition = item end
    end
    local room = floors:CreateRoom(assert(definition), 42)
    local character = Instance.new("Model", workspace)
    character.Name = "TrainExposureFixture"
    local root = Instance.new("Part", character)
    root.Name, root.Anchored, root.CanCollide = "HumanoidRootPart", true, false
    local candidate = {Character = character}
    local hits, mode = {}, "Track"
    room:Initialize({
        isPlayerActive = function() return true end,
        getActivePlayers = function()
            local z = room.model and room.model:GetAttribute("TrainZ") or 0
            local offset = mode == "Platform" and Vector3.new(22, 3, z) or mode == "Above" and Vector3.new(0, 12, z) or Vector3.new(0, 3, z)
            root.CFrame = CFrame.new(floors._floorOrigin + offset)
            return {candidate}
        end,
        damagePlayer = function(_, amount, source)
            assert(amount == 25 and source == "Passing train", "Unexpected train damage")
            table.insert(hits, {amount = amount, time = os.clock(), phase = room.model:GetAttribute("HazardPhase")})
        end,
    })
    local ok, err = xpcall(function()
        room:Start()
        room.startedAt = os.clock() - 8
        task.wait(3.5)
        assert(#hits == 0, "Train damaged during warning")
        task.wait(5)
        assert(#hits == 1, "A pass must damage each player exactly once")
        mode = "Platform"
        room.startedAt = os.clock() - 28
        task.wait(4.5)
        assert(#hits == 1, "Platform was damaged")
        mode = "Above"
        room.startedAt = os.clock() - 44
        task.wait(4.5)
        assert(#hits == 1, "Player above train was damaged")
        for _, part in room.model.Train:GetDescendants() do
            if part:IsA("BasePart") then assert(not part.CanCollide, "Collidable train") end
        end
    end, debug.traceback)
    room:Cleanup()
    character:Destroy()
    workspace.LastStopTrainQA:Destroy()
    return {pass = ok, error = not ok and err or nil, hits = hits}
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">TwoPlayerRecoverySpec</string>
          <string name="Source"><![CDATA[-- Explicit opt-in integration test. Run from a two-player Studio server.
-- Uses isolated geometry and in-memory profiles. Restart Play after completion.
return function()
    assert(game:GetService("RunService"):IsStudio(), "Studio test only")
    local players = game:GetService("Players"):GetPlayers()
    assert(#players == 2, "Start exactly two local clients")
    table.sort(players, function(a, b) return a.UserId < b.UserId end)
    local services = script.Parent.Parent.Services
    local config = table.clone(require(game.ReplicatedStorage.Shared.Config.GameConfig))
    config.BoardingSeconds, config.TravelSeconds, config.EscapeSeconds, config.DecisionSeconds = 1, 1, 10, 12
    local memory = {data = {}}
    for _, player in players do
        memory.data[player] = {Coins = 0, XP = 0, Level = 1, Stats = {Runs = 0, Escapes = 0, BestDepth = 0, FirstEscapeClaimed = true}}
    end
    function memory:Get(player) return self.data[player] end
    function memory:Mutate(player, callback) callback(self.data[player]); return true end
    function memory:Save() return true end
    local floors = require(services.FloorService).new({WorldName = "LastStopV4TwoPlayerTest", FloorOrigin = Vector3.new(2200, 0, 700)})
    floors:BuildWorld()
    local enemies = require(services.EnemyService).new()
    enemies:Start()
    local inventory = require(services.InventoryService).new()
    local economy = require(services.EconomyService).new(memory, config)
    local firstReward = economy:CalculateFloorReward(1, 5)
    local remotes = {}
    for _, remote in game.ReplicatedStorage.Remotes:GetChildren() do remotes[remote.Name] = remote end
    local expedition = require(services.ExpeditionService).new(config, floors, enemies, economy, memory, inventory, remotes, function(reason)
        print("[V4 TWO PLAYER] Finished", reason)
    end)
    local function waitFor(predicate, message, timeout)
        local deadline = os.clock() + (timeout or 20)
        repeat
            if predicate() then return end
            task.wait(.1)
        until os.clock() > deadline
        error("[V4 TWO PLAYER] Timed out " .. message .. " / " .. expedition.state)
    end
    local function interact(room, player, key)
        local entry = assert(room.targets[key], key)
        player.Character:PivotTo(CFrame.new(entry.part.Position + Vector3.new(0, 0, 3)))
        task.wait(.15)
        assert(room:_attemptInteraction(player, key), "Interaction rejected " .. key)
    end
    local function recoverRound(active)
        waitFor(function() return expedition.state == "Floor" end, "floor start")
        local room = expedition.floor
        print("[V4 TWO PLAYER] Testing", room.definition.Id, "active", #active)
        waitFor(function() return #enemies._enemies == 1 end, "monster spawn", 10)
        local stalker = enemies._enemies[1]
        local initial = stalker.root.Position
        waitFor(function() return (stalker.root.Position - initial).Magnitude > 2 end, "physical monster movement", 10)
        local victim = active[1]
        waitFor(function() return os.clock() - expedition.floorStartedAt >= config.StalkerArrivalGraceSeconds end, "arrival grace", 25)
        local humanoid = victim.Character:FindFirstChildOfClass("Humanoid")
        humanoid.Health = 100
        victim.Character:PivotTo(stalker.root.CFrame * CFrame.new(0, 0, -3))
        waitFor(function() return humanoid.Health < 100 end, "telegraphed monster hit", 8)
        assert(humanoid.Health <= 80, "Expected 20 damage")
        humanoid.Health = 100
        -- Keep the live enemy away while validating every objective and economy transition.
        stalker.root.Anchored = true
        stalker.root.CFrame = CFrame.new(floors._floorOrigin + Vector3.new(0, 8, -100))
        local originalStart = room.startedAt
        local subway = room.definition.Template == "AbandonedSubway"
        -- Subway: the train is Active from cycle 12 of 16 and stays in the track lane.
        room.startedAt = os.clock() - ((subway and 13 or 15) - room.seed % 7)
        local exposure = room.definition.Template == "Hospital" and Vector3.new(0, 3, -12)
            or subway and Vector3.new(0, .5, -32) or Vector3.new(20, .5, 20)
        victim.Character:PivotTo(CFrame.new(floors._floorOrigin + exposure))
        waitFor(function() return humanoid.Health < 100 end, "environmental hazard damage", 3)
        assert(humanoid.Health == (subway and 75 or 92), "Hazard must deal a bounded 25 (train) or 8 damage")
        humanoid.Health = 100
        room.startedAt = originalStart
        for key, entry in room.targets do
            local path = game:GetService("PathfindingService"):CreatePath({AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = true})
            path:ComputeAsync(room.spawnCFrame.Position, entry.part.Position + Vector3.new(0, 0, 3))
            assert(path.Status == Enum.PathStatus.Success, "Objective route blocked " .. key)
            path:Destroy()
        end
        local player = active[1]
        assert(not room:_attemptInteraction(player, "Delivery"), "Accepted out-of-order delivery")
        local first, second
        for key, entry in room.targets do
            if entry.stage == 1 then first = key end
            if entry.stage == 2 then second = key end
        end
        interact(room, player, first)
        assert(not room:_attemptInteraction(player, first), "Duplicate milestone accepted")
        interact(room, player, second)
        interact(room, player, "ControlA")
        local teammate = active[2] or player
        interact(room, teammate, "ControlB")
        assert(room.progress == 3, "Paired controls failed")
        interact(room, player, "Sample")
        assert(player:GetAttribute("Carrying"), "Missing carried case")
        local activeCheck = room.context.isPlayerActive
        room.context.isPlayerActive = function(candidate) return candidate ~= player and activeCheck(candidate) end
        waitFor(function() return room.stage == 4 end, "lost-carrier recovery", 2)
        assert(room.progress == 3 and not player:GetAttribute("Carrying"), "Lost case did not reset safely")
        room.context.isPlayerActive = activeCheck
        interact(room, player, "Sample")
        interact(room, player, "Delivery")
        waitFor(function() return expedition.state == "Escape" end, "objective completion")
        assert(room.progress == 5 and not player:GetAttribute("Carrying"), "Case cleanup/progress failed")
        for index, member in active do member.Character:PivotTo(room.escapeCFrame * CFrame.new((index - 1) * 3, 0, 0)) end
        waitFor(function() return expedition.state == "Decision" end, "extraction")
        return room.model, room.definition.Id
    end
    local ok, err = xpcall(function()
        expedition:Start(players)
        local first, firstId = recoverRound(players)
        assert(expedition:RequestDecision(players[1], "Bank"))
        assert(expedition:RequestDecision(players[2], "Continue"))
        waitFor(function() return expedition.depth == 2 and expedition.state == "Floor" end, "second floor")
        assert(first.Parent == nil, "Old floor survived cleanup")
        assert(expedition.floorDefinition.Id ~= firstId, "Repeated consecutive floor")
        assert(economy:GetBankedCoins(players[1]) == firstReward and economy:GetBankedCoins(players[2]) == 0, "Independent banking failed")
        assert(expedition.unbanked[players[2]] == firstReward, "At-risk coins changed")
        assert(not expedition:RequestDecision(players[1], "Bank"), "Banker re-entered decision")
        recoverRound({players[2]})
        assert(expedition:RequestDecision(players[2], "Bank"))
        waitFor(function() return not expedition:IsRunning() end, "final bank")
        assert(economy:GetBankedCoins(players[2]) > firstReward and economy:GetBankedCoins(players[1]) == firstReward, "Second reward isolation failed")
        print("[LAST STOP V4] TWO PLAYER PASS / both floors, reachable objectives, physics, damage, teamwork, solo fallback, case delivery, independent BANK/CONTINUE")
    end, debug.traceback)
    enemies:Destroy()
    if expedition:IsRunning() then expedition:_end("QA cleanup") end
    local world = workspace:FindFirstChild("LastStopV4TwoPlayerTest")
    if world then world:Destroy() end
    assert(ok, err)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">VerticalSliceSpec</string>
          <string name="Source"><![CDATA[return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local EconomyService = require(script.Parent.Parent.Services.EconomyService)
	local RateLimiter = require(ReplicatedStorage.Shared.Util.RateLimiter)

	local fakeProfiles = {}
	local economy = EconomyService.new(fakeProfiles, { FirstEscapeBonus = 50 })
	local depthOneCoins, depthOneXP = economy:CalculateFloorReward(1, 3)
	assert(depthOneCoins == 80, "Expected 80 coins at depth 1 with three objective steps")
	assert(depthOneXP == 25, "Expected 25 XP at depth 1")
	local depthTenCoins = select(1, economy:CalculateFloorReward(10, 3))
	assert(depthTenCoins > depthOneCoins, "Depth multiplier must increase rewards")

	local limiter = RateLimiter.new(2, 60)
	assert(limiter:Allow("player"), "First request should pass")
	assert(limiter:Allow("player"), "Second request should pass")
	assert(not limiter:Allow("player"), "Third request must be blocked")
	limiter:Forget("player")
	assert(limiter:Allow("player"), "Forget must clear a player's bucket")
end
]]></string>
        </Properties>
      </Item>
    </Item>
