        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid:Give(task)
	table.insert(self._tasks, task)
	return task
end

function Maid:Clean()
	for _, task in ipairs(self._tasks) do
		local kind = typeof(task)
		if kind == "RBXScriptConnection" then
			task:Disconnect()
		elseif kind == "Instance" then
			task:Destroy()
		elseif type(task) == "function" then
			task()
		elseif type(task) == "table" and task.Destroy then
			task:Destroy()
		end
	end
	table.clear(self._tasks)
end

function Maid:Destroy()
	self:Clean()
end

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(maxCount, windowSeconds)
	return setmetatable({ maxCount = maxCount, windowSeconds = windowSeconds, buckets = {} }, RateLimiter)
end

function RateLimiter:Allow(key)
	local now = os.clock()
	local bucket = self.buckets[key]
	if not bucket or now - bucket.started >= self.windowSeconds then
		self.buckets[key] = { started = now, count = 1 }
		return true
	end
	if bucket.count >= self.maxCount then
		return false
	end
	bucket.count += 1
	return true
end

function RateLimiter:Forget(key)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- LAST STOP Milestone A server bootstrap. Place as a Script in ServerScriptService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local RemoteNames = require(ReplicatedStorage.Shared.Config.RemoteNames)
local RateLimiter = require(ReplicatedStorage.Shared.Util.RateLimiter)
local ProfileService = require(script.Parent.Services.ProfileService)
local EconomyService = require(script.Parent.Services.EconomyService)
local FloorService = require(script.Parent.Services.FloorService)
local PbrMaterialService = require(script.Parent.Services.PbrMaterialService)
local EnemyService = require(script.Parent.Services.EnemyService)
local InventoryService = require(script.Parent.Services.InventoryService)
local MatchmakingService = require(script.Parent.Services.MatchmakingService)
local ExpeditionService = require(script.Parent.Services.ExpeditionService)

local function ensureRemotes()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	local remotes = {}
	for key, name in pairs(RemoteNames) do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		assert(remote:IsA("RemoteEvent"), "Remote " .. name .. " must be a RemoteEvent")
		remotes[key] = remote
	end
	return remotes
end

local remotes = ensureRemotes()
local profiles = ProfileService.new(GameConfig)
local economy = EconomyService.new(profiles, GameConfig)
local floors = FloorService.new()
local enemyService = EnemyService.new()
local inventory = InventoryService.new()
local lobby = floors:BuildWorld()
PbrMaterialService:Apply(lobby.Model)
enemyService:Start()

Lighting.Brightness = 2
Lighting.ClockTime = 0
Lighting.Ambient = Color3.fromRGB(96, 108, 114)
Lighting.OutdoorAmbient = Color3.fromRGB(20, 25, 31)
Lighting.FogColor = Color3.fromRGB(34, 43, 51)
Lighting.FogEnd = 350
Lighting.GlobalShadows = true
-- LightingStyle is saved in default.project.json (Studio-only capability).
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.6

local function effect(className, name, properties)
	local instance = Lighting:FindFirstChild(name)
	if not instance then
		instance = Instance.new(className)
		instance.Name = name
		instance.Parent = Lighting
	end
	for property, value in pairs(properties) do
		instance[property] = value
	end
	return instance
end

effect("Atmosphere", "LastStopAtmosphere", {
	Density = 0.12,
	Offset = 0.15,
	Color = Color3.fromRGB(145, 169, 182),
	Decay = Color3.fromRGB(38, 55, 65),
	Glare = 0,
	Haze = 1.15,
})
effect("ColorCorrectionEffect", "LastStopGrade", {
	Brightness = -0.03,
	Contrast = 0.12,
	Saturation = -0.08,
	TintColor = Color3.fromRGB(214, 235, 242),
})
effect("BloomEffect", "LastStopBloom", {
	Intensity = 0.18,
	Size = 28,
	Threshold = 1.6,
})

local limiter = RateLimiter.new(GameConfig.RemoteRateLimit.Count, GameConfig.RemoteRateLimit.WindowSeconds)
local currentExpedition = nil
local matchmaking

local function toast(player, message)
	remotes.Toast:FireClient(player, message)
end

local function moveToLobby(player)
	player.RespawnLocation = lobby.SpawnLocation
	task.spawn(function()
		local character = player.Character or player.CharacterAdded:Wait()
		local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
		if root then
			task.wait(.2) -- Allow the engine to finish initial spawn placement.
			if not player.Parent then return end
			character:PivotTo(lobby.LobbySpawn)
		end
	end)
end

local function canQueue(player)
	return profiles:Get(player) ~= nil and (not currentExpedition or not currentExpedition:IsRunning())
end

matchmaking = MatchmakingService.new(GameConfig, canQueue, function(group, finished)
	local expedition
	expedition = ExpeditionService.new(
		GameConfig,
		floors,
		enemyService,
		economy,
		profiles,
		inventory,
		remotes,
		function(reason)
			if currentExpedition == expedition then
				currentExpedition = nil
			end
			finished()
			print("[LAST STOP] Expedition ended:", reason)
		end
	)
	currentExpedition = expedition
	expedition:Start(group)
end, toast)

local function remotelyAllowed(remoteName, player)
	if not limiter:Allow(remoteName .. ":" .. player.UserId) then
		toast(player, "Too many requests. Please wait a moment.")
		return false
	end
	return true
end

remotes.RequestQueue.OnServerEvent:Connect(function(player, ...)
	if select("#", ...) ~= 0 or not remotelyAllowed("Queue", player) then
		return
	end
	local ok, message = matchmaking:RequestJoin(player)
	toast(player, message)
end)

remotes.RequestDecision.OnServerEvent:Connect(function(player, decision, ...)
	if select("#", ...) ~= 0 or type(decision) ~= "string" or #decision > 10 or not remotelyAllowed("Decision", player) then
		return
	end
	if not currentExpedition then
		return
	end
	local ok, message = currentExpedition:RequestDecision(player, decision)
	if not ok then
		toast(player, message)
	end
end)

remotes.RequestMedkit.OnServerEvent:Connect(function(player, ...)
	if select("#", ...) ~= 0 or not remotelyAllowed("Medkit", player) then
		return
	end
	if currentExpedition then
		local ok, message = currentExpedition:RequestMedkit(player)
		toast(player, message)
	end
end)

lobby.QueuePrompt.Triggered:Connect(function(player)
	local ok, message = matchmaking:RequestJoin(player)
	toast(player, message)
end)

local function onPlayerAdded(player)
	profiles:Load(player)
	player:SetAttribute("LastStopProfileLoaded", true)
	moveToLobby(player)
	toast(player, "Welcome to LAST STOP. Queue at the terminal or press PLAY.")
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	matchmaking:Remove(player)
	if currentExpedition then
		currentExpedition:OnPlayerRemoving(player)
	end
	limiter:Forget("Queue:" .. player.UserId)
	limiter:Forget("Decision:" .. player.UserId)
	limiter:Forget("Medkit:" .. player.UserId)
	profiles:Release(player)
end)

task.spawn(function()
	while task.wait(GameConfig.AutosaveSeconds) do
		profiles:SaveAll()
	end
end)

game:BindToClose(function()
	if currentExpedition then
		currentExpedition:Destroy()
	end
	profiles:SaveAll()
end)

matchmaking:Start()
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[local EconomyConfig = require(game:GetService("ReplicatedStorage").Shared.Config.EconomyConfig)

local EconomyService = {}
EconomyService.__index = EconomyService

function EconomyService.new(profileService, gameConfig)
	return setmetatable({ _profiles = profileService, _gameConfig = gameConfig }, EconomyService)
end

function EconomyService:CalculateFloorReward(depth, objectiveProgress)
	local multiplier = math.min(
		1 + math.max(0, depth - 1) * EconomyConfig.DepthMultiplierStep,
		EconomyConfig.MaxDepthMultiplier
	)
	local gross = EconomyConfig.BaseFloorCoins + EconomyConfig.TeamCompletionBonus
		+ EconomyConfig.ObjectiveBonus + objectiveProgress * EconomyConfig.XPPerObjectiveStep
	return math.floor(gross * multiplier), math.floor(EconomyConfig.XPPerFloor * multiplier)
end

function EconomyService:Bank(player, unbanked, pendingXP, depth)
	if unbanked <= 0 then
		return 0
	end
	local granted = 0
	self._profiles:Mutate(player, function(profile)
		profile.Coins += unbanked
		profile.XP += math.max(0, pendingXP or 0)
		profile.Level = math.max(1, math.floor(profile.XP / 100) + 1)
		profile.Stats.Escapes += 1
		profile.Stats.BestDepth = math.max(profile.Stats.BestDepth or 0, depth)
		if not profile.Stats.FirstEscapeClaimed then
			profile.Stats.FirstEscapeClaimed = true
			profile.Coins += self._gameConfig.FirstEscapeBonus
			granted = unbanked + self._gameConfig.FirstEscapeBonus
		else
			granted = unbanked
		end
	end)
	self._profiles:Save(player)
	return granted
end

function EconomyService:GetBankedCoins(player)
	local profile = self._profiles:Get(player)
	return profile and profile.Coins or 0
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[-- Original articulated Stalker prefab. Humanoid physics follows full paths;
-- the server owns targeting, windup, damage, gait and cleanup.
local PathfindingService=game:GetService("PathfindingService")
local RunService=game:GetService("RunService")
local ServerStorage=game:GetService("ServerStorage")
local Pbr=require(script.Parent.PbrMaterialService)
local EnemyService={}
EnemyService.__index=EnemyService
local Stalker={}
Stalker.__index=Stalker

function Stalker.new(parent,patrol,context)
	local template=ServerStorage:WaitForChild("LastStopAssets"):FindFirstChild("Stalker")
	assert(template and template:IsA("Model"),"[LAST STOP] Missing authored Stalker prefab; rebuild assets/prefabs")
	local model=template:Clone()
	model:PivotTo(CFrame.new(patrol[1]))
	model.Parent=parent
	local root=model:FindFirstChild("HumanoidRootPart")
	local humanoid=model:FindFirstChildOfClass("Humanoid")
	assert(root and humanoid,"[LAST STOP] Stalker rig requires HumanoidRootPart + Humanoid")
	pcall(function() root:SetNetworkOwner(nil) end)
	Pbr:Apply(model)
	local self=setmetatable({model=model,root=root,humanoid=humanoid,patrolPoints=patrol,context=context,
		state="Patrol",patrolIndex=2,connections={},motors={},lastPath=0,pathToken=0,attackAt=0,clock=0},Stalker)
	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("Motor6D") then self.motors[v]={base=v.C0,name=v.Name} end
	end
	table.insert(self.connections,humanoid.MoveToFinished:Connect(function(reached)
		if self.destroyed then return end
		if reached and self.waypoints then self.waypointIndex+=1;self:_nextWaypoint()
		else self.lastPath=0 end
	end))
	return self
end
function Stalker:_setState(state)
	self.state=state;self.model:SetAttribute("AIState",state)
end
function Stalker:_canSee(root)
	local params=RaycastParams.new()
	params.FilterType,params.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{self.model}
	local origin=self.root.Position+Vector3.new(0,1.5,0)
	local hit=workspace:Raycast(origin,root.Position-origin,params)
	return not hit or hit.Instance:IsDescendantOf(root.Parent)
end
function Stalker:_target()
	local chosen,distance=nil,60
	for _, player in ipairs(self.context.getActivePlayers()) do
		local character=player.Character
		local root=character and character:FindFirstChild("HumanoidRootPart")
		local humanoid=character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health>0 then
			local d=(root.Position-self.root.Position).Magnitude
			if d<distance and self:_canSee(root) then chosen,distance=player,d end
		end
	end
	return chosen,distance
end
function Stalker:_nextWaypoint()
	local waypoint=self.waypoints and self.waypoints[self.waypointIndex]
	if not waypoint then return end
	if waypoint.Action==Enum.PathWaypointAction.Jump then self.humanoid.Jump=true end
	self.humanoid:MoveTo(waypoint.Position)
end
function Stalker:_pathTo(position)
	if self.computing or os.clock()-self.lastPath<1.2 then return end
	self.lastPath=os.clock();self.pathToken+=1
	local token=self.pathToken
	self.computing=true
	task.spawn(function()
		local path=PathfindingService:CreatePath({AgentRadius=1.6,AgentHeight=8,AgentCanJump=false,WaypointSpacing=5})
		local ok=pcall(function() path:ComputeAsync(self.root.Position,position) end)
		self.computing=false
		if self.destroyed or token~=self.pathToken then path:Destroy();return end
		if self.blockedConnection then self.blockedConnection:Disconnect();self.blockedConnection=nil end
		if self.path then self.path:Destroy();self.path=nil end
		if ok and path.Status==Enum.PathStatus.Success then
			self.path=path;self.waypoints=path:GetWaypoints();self.waypointIndex=2
			self.blockedConnection=path.Blocked:Connect(function(index)
				if index>=self.waypointIndex then self.lastPath=0 end
			end)
			self:_nextWaypoint()
		else
			path:Destroy()
			-- Physics/collision remains authoritative when no path exists.
			self.waypoints=nil;self.humanoid:MoveTo(self.root.Position)
		end
	end)
end
function Stalker:Step(dt)
	if self.destroyed or not self.root.Parent then return end
	self.clock+=dt
	local velocity=self.root.AssemblyLinearVelocity
	local moving=Vector3.new(velocity.X,0,velocity.Z).Magnitude>1
	local swing=moving and math.sin(self.clock*6)*.42 or math.sin(self.clock*1.5)*.025
	for motor,info in pairs(self.motors) do
		local angle=0
		if info.name=="Left Hip" or info.name=="Right Shoulder" then angle=swing end
		if info.name=="Right Hip" or info.name=="Left Shoulder" then angle=-swing end
		if self.state=="Attack" and info.name=="Right Shoulder" then angle=-1.3 end
		motor.C0=info.base*CFrame.Angles(angle,0,0)
	end
	self.think=(self.think or 0)+dt
	if self.think<.15 then return end
	self.think=0
	if self.state=="Attack" then return end
	local player,distance=self:_target()
	if player then
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end
		if distance<5 and os.clock()-self.attackAt>2.8 then
			self.attackAt=os.clock();self:_setState("Attack")
			self.humanoid:MoveTo(self.root.Position)
			task.delay(.65,function()
				if self.destroyed then return end
				local target=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if target and (target.Position-self.root.Position).Magnitude<5.5 and self:_canSee(target) then self.context.damagePlayer(player,15,"Stalker") end
				self:_setState("Chase");self.lastPath=0
			end)
		else
			self:_setState("Chase");self.humanoid.WalkSpeed=12;self:_pathTo(root.Position)
		end
	else
		self:_setState("Patrol");self.humanoid.WalkSpeed=8
		local point=self.patrolPoints[self.patrolIndex] or self.patrolPoints[1]
		local offset=self.root.Position-point
		if Vector3.new(offset.X,0,offset.Z).Magnitude<4 then self.patrolIndex=self.patrolIndex%#self.patrolPoints+1;self.lastPath=0 end
		self:_pathTo(self.patrolPoints[self.patrolIndex])
	end
end
function Stalker:Destroy()
	self.destroyed=true;self.pathToken+=1
	for _, c in ipairs(self.connections) do c:Disconnect() end
	if self.blockedConnection then self.blockedConnection:Disconnect() end
	if self.path then self.path:Destroy() end
	self.model:Destroy()
end
function EnemyService.new() return setmetatable({_enemies={}},EnemyService) end
function EnemyService:SpawnStalker(parent,patrol,context)
	local enemy=Stalker.new(parent,patrol,context);table.insert(self._enemies,enemy);return enemy
end
function EnemyService:Start()
	self._connection=RunService.Heartbeat:Connect(function(dt) for _, enemy in ipairs(self._enemies) do enemy:Step(dt) end end)
end
function EnemyService:Clear() for _, enemy in ipairs(self._enemies) do enemy:Destroy() end;table.clear(self._enemies) end
function EnemyService:Destroy() self:Clear();if self._connection then self._connection:Disconnect() end end
return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ExpeditionService</string>
          <string name="Source"><![CDATA[-- Server-owned expedition state machine. The client receives snapshots for UI
-- only; it never supplies damage, coins, objective progress, or escape status.
local FloorConfig = require(game:GetService("ReplicatedStorage").Shared.Config.FloorConfig)

local ExpeditionService = {}
ExpeditionService.__index = ExpeditionService

local function inBox(position, cframe, size)
	local localPosition = cframe:PointToObjectSpace(position)
	local half = size * 0.5
	return math.abs(localPosition.X) <= half.X
		and math.abs(localPosition.Y) <= half.Y
		and math.abs(localPosition.Z) <= half.Z
end

local function characterRoot(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function characterHumanoid(player)
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function ExpeditionService.new(config, floorService, enemyService, economyService, profileService, inventoryService, remotes, onFinished)
	return setmetatable({
		_config = config,
		_floorService = floorService,
		_enemyService = enemyService,
		_economyService = economyService,
		_profileService = profileService,
		_inventoryService = inventoryService,
		_remotes = remotes,
		_onFinished = onFinished,
		state = "Idle",
		_token = 0,
		active = {},
		allPlayers = {},
		unbanked = {},
		pendingXP = {},
		votes = {},
		recentFloorIds = {},
		connections = {},
		depth = 0,
		floor = nil,
		floorDefinition = nil,
	}, ExpeditionService)
end

function ExpeditionService:IsRunning()
	return self.state ~= "Idle" and self.state ~= "Ended"
end

function ExpeditionService:_activePlayers()
	local result = {}
	for player in pairs(self.active) do
		if player.Parent then
			table.insert(result, player)
		end
	end
	return result
end

function ExpeditionService:_activeCount()
	return #self:_activePlayers()
end

function ExpeditionService:_send(player, patch)
	if not player.Parent then
		return
	end
	local payload = {
		state = self.state,
		depth = self.depth,
		floorName = self.floorDefinition and self.floorDefinition.Name or "Lobby",
		objective = self.floorDefinition and self.floorDefinition.Prompt or "Queue for an expedition.",
		progress = self.floor and select(1, self.floor:ObjectiveProgress()) or 0,
		target = self.floorDefinition and self.floorDefinition.Target or 0,
		unbanked = self.unbanked[player] or 0,
		banked = self._economyService:GetBankedCoins(player),
		activePlayers = self:_activeCount(),
		seed = self.seed,
	}
	for key, value in pairs(patch or {}) do
		payload[key] = value
	end
	self._remotes.StateChanged:FireClient(player, payload)
end

function ExpeditionService:_broadcast(patch)
	for _, player in ipairs(self:_activePlayers()) do
		self:_send(player, patch)
	end
end

function ExpeditionService:_toast(player, text)
	if player.Parent then
		self._remotes.Toast:FireClient(player, text)
	end
end

function ExpeditionService:_setState(nextState, patch)
	self.state = nextState
	self:_broadcast(patch)
end

function ExpeditionService:_movePlayer(player, cframe)
	task.spawn(function()
		if not player.Parent then
			return
		end
		local character = player.Character
		if not character then
			player:LoadCharacter()
			character = player.CharacterAdded:Wait()
		end
		local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
		if root then
			character:PivotTo(cframe)
		end
	end)
end

function ExpeditionService:_returnToLobby(player)
	local lobby = self._floorService.lobby
	if lobby then
		task.spawn(function()
			if not player.Parent then return end
			local previousCharacter = player.Character
			-- A player can leave between the parent check and LoadCharacter(),
			-- especially when a Studio play session stops. Do not let that race
			-- turn an otherwise-clean expedition teardown into an Output error.
			local loaded = pcall(function()
				if player.Parent then
					player:LoadCharacter()
				end
			end)
			if not loaded or not player.Parent then
				return
			end

			local character = player.Character
			for _ = 1, 120 do
				if not player.Parent then
					return
				end
				if character and character ~= previousCharacter then
					break
				end
				task.wait()
				character = player.Character
			end
			if not character or character == previousCharacter then return end
			local root = character and (character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5))
			if root then
				character:PivotTo(lobby.LobbySpawn)
			end
		end)
	end
end

function ExpeditionService:_watchPlayer(player)
	local function watchCharacter(character)
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
		if humanoid then
			table.insert(self.connections, humanoid.Died:Connect(function()
				self:OnPlayerDied(player, "You were overwhelmed.")
			end))
		end
	end
	if player.Character then
		watchCharacter(player.Character)
	end
	table.insert(self.connections, player.CharacterAdded:Connect(watchCharacter))
end

function ExpeditionService:Start(players)
	assert(not self:IsRunning(), "An expedition is already running")
	self._token += 1
	local token = self._token
	self.state = "Boarding"
	self.depth = 0
	self.seed = (os.time() + math.random(1, 1000000)) % 2147483647
	self.active = {}
	self.allPlayers = {}
	self.unbanked = {}
	self.pendingXP = {}
	self.votes = {}
	self.recentFloorIds = {}
	self.floor = nil
	self.floorDefinition = nil
	for _, player in ipairs(players) do
		self.active[player] = true
		self.allPlayers[player] = true
		self.unbanked[player] = 0
		self.pendingXP[player] = 0
		self._inventoryService:BeginRun(player)
		self:_watchPlayer(player)
		self:_movePlayer(player, self._floorService.lobby.BoardCFrame)
	end
	self._floorService:SetLobbyElevator(true, "BOARD NOW")
	self:_broadcast({ message = "Board the elevator. Departure is imminent." })
	print("[LAST STOP] Expedition seed", self.seed, "players", #players)
	task.spawn(function()
		if not self:_wait(self._config.BoardingSeconds, token) then
			return
		end
		self._floorService:SetLobbyElevator(false, "DESCENDING")
		self:_beginNextFloor(token)
	end)
end

function ExpeditionService:_wait(seconds, token, predicate)
	local finishAt = os.clock() + seconds
	while os.clock() < finishAt do
		if self._token ~= token or not self:IsRunning() then
			return false
		end
		if predicate and predicate() then
			return true
		end
		task.wait(0.2)
	end
	return self._token == token and self:IsRunning()
end

function ExpeditionService:_chooseFloor()
	local candidates = {}
	for _, definition in ipairs(FloorConfig.Floors) do
		local recent = false
		for _, recentId in ipairs(self.recentFloorIds) do
			if recentId == definition.Id then
				recent = true
				break
			end
		end
		if not recent then
			table.insert(candidates, definition)
		end
	end
	if #candidates == 0 then
		candidates = FloorConfig.Floors
	end
	local totalWeight = 0
	for _, definition in ipairs(candidates) do
		totalWeight += definition.Weight
	end
	local random = Random.new(self.seed + self.depth * 104729)
	local roll = random:NextNumber(0, totalWeight)
	for _, definition in ipairs(candidates) do
		roll -= definition.Weight
		if roll <= 0 then
			return definition
		end
	end
	return candidates[#candidates]
end

function ExpeditionService:_beginNextFloor(token)
	if self._token ~= token or self:_activeCount() == 0 then
		self:_end("No eligible players remain.")
		return
	end
	self:_setState("Travel", { message = "Descending..." })
	if not self:_wait(self._config.TravelSeconds, token) then
		return
	end
	self.depth += 1
	self.floorDefinition = self:_chooseFloor()
	table.insert(self.recentFloorIds, self.floorDefinition.Id)
	if #self.recentFloorIds > self._config.RecentFloorWindow then
		table.remove(self.recentFloorIds, 1)
	end
	self.floor = self._floorService:CreateRoom(self.floorDefinition, self.seed + self.depth)
	self.floor:Initialize({
		interactionDistance = self._config.InteractionDistance,
		isPlayerActive = function(player)
			return self.state == "Floor" and self.active[player] == true
		end,
		onObjectiveStep = function(player, key)
			self:_onObjectiveStep(player, key)
		end,
	})
	self.floor:Start()
	for index, player in ipairs(self:_activePlayers()) do
		self:_movePlayer(player, self.floor.spawnCFrame * CFrame.new((((index - 1) % 4) - 1.5) * 3, 0, (math.floor((index - 1) / 4) - 1) * 3))
	end
	self:_setState("Floor", { message = self.floorDefinition.Prompt })
	task.delay(5, function()
		if self._token == token and self.state == "Floor" and self.floor then
			self._enemyService:SpawnStalker(self.floor.model, self.floor.patrolPoints, {
				getActivePlayers = function() return self:_activePlayers() end,
				damagePlayer = function(player, amount, source) self:DamagePlayer(player, amount, source) end,
			})
			self:_broadcast({ message = "Something is moving in the dark." })
		end
	end)
	task.delay(self._config.FloorTimeLimitSeconds, function()
		if self._token == token and self.state == "Floor" then
			self:_failCurrentFloor("The floor sealed before the objective was completed.")
		end
	end)
end

function ExpeditionService:_onObjectiveStep(player, key)
	if self.state ~= "Floor" or not self.floor then
		return
	end
	local progress, target = self.floor:ObjectiveProgress()
	self:_broadcast({ message = player.DisplayName .. " advanced the objective (" .. progress .. "/" .. target .. ")." })
	if progress >= target then
		task.spawn(function()
			self:_completeCurrentFloor()
		end)
	end
end

function ExpeditionService:_completeCurrentFloor()
	if self.state ~= "Floor" or not self.floor then
		return
	end
	local progress = select(1, self.floor:ObjectiveProgress())
	if progress < self.floorDefinition.Target then
		return
	end
	self.floor:Complete()
	self._enemyService:Clear()
	local coins, xp = self._economyService:CalculateFloorReward(self.depth, progress)
	for _, player in ipairs(self:_activePlayers()) do
		self.unbanked[player] += coins
		self.pendingXP[player] += xp
	end
	self:_enterEscape(self._token, coins)
end

function ExpeditionService:_isInEscapeRegion(player)
	if not self.floor then
		return false
	end
	local root = characterRoot(player)
	local humanoid = characterHumanoid(player)
	return root ~= nil and humanoid ~= nil and humanoid.Health > 0
		and inBox(root.Position, self.floor.escapeCFrame, self.floor.escapeSize)
end

function ExpeditionService:_enterEscape(token, coins)
	if self._token ~= token or self.state ~= "Floor" then
		return
	end
	self:_setState("Escape", { message = "Objective complete. Return to the elevator: +" .. coins .. " at risk." })
	local allSafe = self:_wait(self._config.EscapeSeconds, token, function()
		for _, player in ipairs(self:_activePlayers()) do
			if not self:_isInEscapeRegion(player) then
				return false
			end
		end
		return self:_activeCount() > 0
	end)
	if self._token ~= token or self.state ~= "Escape" then
		return
	end
	for _, player in ipairs(self:_activePlayers()) do
		if not self:_isInEscapeRegion(player) then
			self:_eliminate(player, "You missed the elevator and lost your at-risk haul.")
		end
	end
	if self:_activeCount() == 0 then
		self:_end("No one made the elevator.")
		return
	end
	self:_enterDecision(token)
end

function ExpeditionService:_enterDecision(token)
	if self._token ~= token or self:_activeCount() == 0 then
		return
	end
	self.votes = {}
	self:_setState("Decision", {
		message = "BANK to secure your haul, or CONTINUE and keep it at risk.",
		decisionDeadline = os.time() + self._config.DecisionSeconds,
	})
	self:_wait(self._config.DecisionSeconds, token, function()
		for _, player in ipairs(self:_activePlayers()) do
			if not self.votes[player] then
				return false
			end
		end
		return true
	end)
	if self._token ~= token or self.state ~= "Decision" then
		return
	end
	local continuers = {}
	for _, player in ipairs(self:_activePlayers()) do
		if self.votes[player] == "Continue" then
			table.insert(continuers, player)
		else
			self:_bankAndReturn(player)
		end
	end
	if #continuers == 0 then
		self:_end("All surviving players banked their rewards.")
		return
	end
	if self.floor then
		self.floor:Cleanup()
		self.floor = nil
	end
	self:_beginNextFloor(token)
end

function ExpeditionService:RequestDecision(player, decision)
	if self.state ~= "Decision" or not self.active[player] then
		return false, "There is no active bank decision."
	end
	if decision ~= "Bank" and decision ~= "Continue" then
		return false, "Invalid decision."
	end
	self.votes[player] = decision
	self:_toast(player, decision == "Bank" and "You will bank at this stop." or "You will continue with your haul at risk.")
	return true
end

function ExpeditionService:RequestMedkit(player)
	return self._inventoryService:UseMedkit(player, function(candidate)
		return candidate == player and self.active[player] == true and (self.state == "Floor" or self.state == "Escape")
	end)
end

function ExpeditionService:_bankAndReturn(player)
	if not self.active[player] then
		return
	end
	local atRisk = self.unbanked[player] or 0
	local secured = self._economyService:Bank(player, atRisk, self.pendingXP[player] or 0, self.depth)
	self.active[player] = nil
	self.unbanked[player] = 0
	self.pendingXP[player] = 0
	self._inventoryService:EndRun(player)
	self:_send(player, { state = "Results", result = "BANKED", secured = secured, message = "Secured " .. secured .. " coins." })
	self:_returnToLobby(player)
	self._floorService:SetLobbyElevator(true, "LAST STOP")
end

function ExpeditionService:_eliminate(player, reason)
	if not self.active[player] then
		return
	end
	local lost = self.unbanked[player] or 0
	self.active[player] = nil
	self.unbanked[player] = 0
	self.pendingXP[player] = 0
	self._inventoryService:EndRun(player)
	self:_send(player, { state = "Results", result = "LOST", lost = lost, message = reason })
	self:_returnToLobby(player)
	self._floorService:SetLobbyElevator(true, "LAST STOP")
end

function ExpeditionService:DamagePlayer(player, amount, source)
	if not self.active[player] or (self.state ~= "Floor" and self.state ~= "Escape") then
		return
	end
	if type(amount) ~= "number" or amount <= 0 or amount > 30 then
		return
	end
	local humanoid = characterHumanoid(player)
	if humanoid and humanoid.Health > 0 then
		humanoid:TakeDamage(amount)
		self:_toast(player, source .. " hit you for " .. amount .. ".")
	end
end

function ExpeditionService:OnPlayerDied(player, reason)
	if not self.active[player] then
		return
	end
	self:_eliminate(player, reason)
	if self:_activeCount() == 0 then
		self:_end("The expedition has no survivors.")
	end
end

function ExpeditionService:OnPlayerRemoving(player)
	if self.active[player] then
		self:_eliminate(player, "You disconnected and lost unbanked rewards.")
		if self:_activeCount() == 0 then
			self:_end("The expedition has no survivors.")
		end
	end
end

function ExpeditionService:_failCurrentFloor(reason)
	if self.floor then
		self.floor:Fail()
	end
	for _, player in ipairs(self:_activePlayers()) do
		self:_eliminate(player, reason)
	end
	self:_end(reason)
end

function ExpeditionService:_end(reason)
	if self.state == "Ended" or self.state == "Idle" then
		return
	end
	self._token += 1
	self._enemyService:Clear()
	if self.floor then
		self.floor:Cleanup()
		self.floor = nil
	end
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	table.clear(self.connections)
	self.state = "Ended"
	for player in pairs(self.allPlayers) do
		if player.Parent and self.active[player] then
			self:_eliminate(player, reason)
		end
	end
	self.active = {}
	if self._onFinished then
		self._onFinished(reason)
	end
end

function ExpeditionService:Destroy()
	self:_end("Server shutdown")
end

return ExpeditionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">FloorService</string>
          <string name="Source"><![CDATA[-- Authored models are immutable sources in ServerStorage. Only our Runtime
-- clones are disposable; never destroy LastStopWorld or its authored siblings.
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Pbr = require(script.Parent.PbrMaterialService)
local FloorService = {}
FloorService.__index = FloorService
local BUILD = "RECOVERY V3 / AUTHORED HOSPITAL"
local function need(parent, name, class)
	local child = parent:FindFirstChild(name)
	assert(child and child:IsA(class), ("[LAST STOP] Missing %s %s.%s; run node tools/build-prefabs.mjs then rojo build default.project.json."):format(class,parent:GetFullName(),name))
	return child
end
local function library() return need(ServerStorage,"LastStopAssets","Folder") end
local function clone(parent,name) return need(parent,name,"Model"):Clone() end
local function marker(model,name) return need(need(model,"Markers","Folder"),name,"BasePart") end
local function display(part,text)
	for _, v in ipairs(part:GetDescendants()) do if v:IsA("TextLabel") then v.Text=text end end
end
local function prepareDoors(model)
	local result={}
	for _, side in ipairs({"Left","Right"}) do
		local door=need(model,"Door"..side,"BasePart")
		for _, v in ipairs(door:GetDescendants()) do
			if v:IsA("BasePart") then
				v.Anchored,v.CanCollide,v.Massless=false,false,true
				local w=Instance.new("WeldConstraint")
				w.Part0,w.Part1,w.Parent=door,v,v
			end
		end
		result[side]=door
	end
	return result
end
function FloorService.new(options)
	options=options or {}
	return setmetatable({_worldName=options.WorldName or "LastStopWorld",_floorOrigin=options.FloorOrigin or Vector3.new(0,0,700),_doorTweens={},_doorGeneration=0},FloorService)
end
function FloorService:BuildWorld()
	local lobby,elevator=clone(library(),"Lobby"),clone(library(),"Elevator")
	local spawn,socket=marker(lobby,"EntranceSpawn"),marker(lobby,"ElevatorSocket")
	marker(lobby,"RoomBounds")
	elevator:PivotTo(socket.CFrame)
	elevator.Name,elevator.Parent="CentralElevator",lobby
	local board,zone=marker(elevator,"EntranceSpawn"),marker(elevator,"ElevatorReturnZone")
	local doors=prepareDoors(elevator)
	local prompt=Instance.new("ProximityPrompt")
	prompt.ActionText,prompt.ObjectText="Board expedition","Deep access terminal"
	prompt.MaxActivationDistance,prompt.RequiresLineOfSight,prompt.Parent=12,true,need(lobby,"QueueConsole","BasePart")
	local world=workspace:FindFirstChild(self._worldName)
	if not world then world=Instance.new("Folder");world.Name=self._worldName;world.Parent=workspace end
	local old=world:FindFirstChild("Runtime")
	if old then old:Destroy() end
	local runtime,active=Instance.new("Folder"),Instance.new("Folder")
	runtime.Name,runtime.Parent="Runtime",world
	active.Name,active.Parent,lobby.Parent="ActiveExpedition",runtime,runtime
	lobby:SetAttribute("BuildVersion",BUILD)
	lobby:SetAttribute("SourceTemplate","ServerStorage.LastStopAssets.Lobby")
	Pbr:Apply(lobby)
	self._world,self._runtime,self._activeFolder=world,runtime,active
	self.lobby={Model=lobby,QueuePrompt=prompt,LobbySpawn=spawn.CFrame,SpawnLocation=need(lobby,"LobbySpawnPoint","SpawnLocation"),BoardCFrame=board.CFrame,
		BoardRegionCFrame=zone.CFrame,BoardRegionSize=zone.Size,Doors=doors,
		DoorClosed={Left=doors.Left.CFrame,Right=doors.Right.CFrame},
		DoorOpen={Left=doors.Left.CFrame*CFrame.new(-9.8,0,0),Right=doors.Right.CFrame*CFrame.new(9.8,0,0)},
		Display=need(elevator,"FloorDisplay","BasePart")}
	workspace:SetAttribute("LastStopBuild",BUILD)
	self:SetLobbyElevator(true,"B0 / CONCOURSE")
	print("[LAST STOP] "..BUILD.." loaded prefab Lobby + Elevator")
	return self.lobby
end
function FloorService:SetLobbyElevator(open,text)
	if not self.lobby then return end
	self._doorGeneration+=1
	local generation=self._doorGeneration
	for _, t in ipairs(self._doorTweens) do t:Cancel() end
	table.clear(self._doorTweens)
	if not open then
		local params=OverlapParams.new()
		params.FilterType,params.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{self.lobby.Model}
		local deadline=os.clock()+2
		while os.clock()<deadline do
			local blocked=false
			for _, p in ipairs(workspace:GetPartBoundsInBox(self.lobby.BoardRegionCFrame*CFrame.new(0,0,8.5),Vector3.new(19,12,2),params)) do
				if p.Parent and p.Parent:FindFirstChildOfClass("Humanoid") then blocked=true;break end
			end
			if not blocked then break end
			task.wait(.1)
			if generation~=self._doorGeneration then return end
		end
	end
	local positions=open and self.lobby.DoorOpen or self.lobby.DoorClosed
	for side,door in pairs(self.lobby.Doors) do
		door.CanCollide=false -- No crushing during a synchronized travel transition.
		local t=TweenService:Create(door,TweenInfo.new(.85,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{CFrame=positions[side]})
		table.insert(self._doorTweens,t);t:Play()
	end
	if text then display(self.lobby.Display,text) end
end
local Room={}
Room.__index=Room
function Room:Initialize(context) self.context=context end
function Room:Start()
	assert(self.context,"Initialize the floor before Start")
	assert(self.definition.Template=="Hospital","[LAST STOP] No prefab configured; recovery slice requires Template=Hospital")
	local model=clone(need(library(),"Floors","Folder"),"Hospital")
	model:PivotTo(CFrame.new(self._floorService._floorOrigin))
	local spawn,zone=marker(model,"EntranceSpawn"),marker(model,"ElevatorReturnZone")
	marker(model,"RoomBounds")
	local enemy=marker(model,"EnemySpawn")
	local sockets=need(model,"ObjectiveSockets","Folder")
	local targets={}
	for _, v in ipairs(sockets:GetDescendants()) do
		if v:IsA("BasePart") and v:FindFirstChild("ObjectiveCaption") then table.insert(targets,v) end
	end
	table.sort(targets,function(a,b) return a.Name<b.Name end)
	assert(#targets==self.definition.Target,"[LAST STOP] Hospital requires three record props in ObjectiveSockets")
	self.model,self.targets,self.connections=model,{},{}
	self.spawnCFrame,self.escapeCFrame,self.escapeSize=spawn.CFrame,zone.CFrame,zone.Size
	local elevator=clone(library(),"Elevator")
	elevator:PivotTo(marker(model,"ElevatorSocket").CFrame)
	elevator.Name,elevator.Parent="ReturnElevator",model
	for side,door in pairs(prepareDoors(elevator)) do door.CFrame*=CFrame.new(side=="Left" and -9.8 or 9.8,0,0) end
	display(need(elevator,"FloorDisplay","BasePart"),"01 / CLINICAL ARCHIVE")
	for index,target in ipairs(targets) do
		local key=self.definition.Id.."_"..index
		target:SetAttribute("ObjectiveKey",key);target:SetAttribute("Used",false)
		self.targets[key]=target
		local prompt=Instance.new("ProximityPrompt")
		prompt.ActionText,prompt.ObjectText="Recover record",target.ObjectiveCaption.Value
		prompt.HoldDuration,prompt.MaxActivationDistance,prompt.RequiresLineOfSight=.8,self.context.interactionDistance,true
		prompt.KeyboardKeyCode,prompt.GamepadKeyCode,prompt.Parent=Enum.KeyCode.E,Enum.KeyCode.ButtonX,target
		table.insert(self.connections,prompt.Triggered:Connect(function(player) self:_attemptInteraction(player,key) end))
	end
	local patrol=need(need(model,"Markers","Folder"),"PatrolPaths","Folder"):GetChildren()
	table.sort(patrol,function(a,b) return a.Name<b.Name end)
	self.patrolPoints={enemy.Position}
	for _, point in ipairs(patrol) do assert(point:IsA("BasePart"));table.insert(self.patrolPoints,point.Position) end
	model.Name,model.Parent="Hospital",self._floorService._activeFolder
	model:SetAttribute("SourceTemplate","ServerStorage.LastStopAssets.Floors.Hospital")
	Pbr:Apply(model)
	return self
end
function Room:_attemptInteraction(player,key)
	local target=self.targets[key]
	if not target or target:GetAttribute("Used") or not self.context.isPlayerActive(player) then return end
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position-target.Position).Magnitude>self.context.interactionDistance then return end
	local params=RaycastParams.new()
	params.FilterType,params.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{character}
	local hit=workspace:Raycast(root.Position,target.Position-root.Position,params)
	if hit and hit.Instance~=target and not hit.Instance:IsDescendantOf(target.Parent) then return end
	target:SetAttribute("Used",true)
	local prompt=target:FindFirstChildOfClass("ProximityPrompt")
	if prompt then prompt.Enabled=false end
	target.Color=Color3.fromRGB(99,216,213)
	TweenService:Create(target,TweenInfo.new(.25),{Transparency=.85,CFrame=target.CFrame*CFrame.new(0,.8,0)}):Play()
	self.context.onObjectiveStep(player,key)
end
function Room:ObjectiveProgress()
	local used=0
	for _, target in pairs(self.targets) do if target:GetAttribute("Used") then used+=1 end end
	return used,self.definition.Target
end
function Room:Complete() self.completed=true;if self.model then self.model:SetAttribute("Complete",true) end end
function Room:Fail() if self.model then self.model:SetAttribute("Failed",true) end end
function Room:Cleanup()
	for _, c in ipairs(self.connections) do c:Disconnect() end
	table.clear(self.connections)
	if self.model then self.model:Destroy();self.model=nil end
	self.targets={}
end
function FloorService:CreateRoom(definition,seed)
	return setmetatable({_floorService=self,definition=definition,seed=seed,targets={},connections={}},Room)
end
return FloorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[-- Minimal vertical-slice equipment: a real togglable flashlight and one server
-- validated medkit per expedition. Broader equipment ships in Milestone B.
local InventoryService = {}
InventoryService.__index = InventoryService

local function makeFlashlight()
	local tool = Instance.new("Tool")
	tool.Name = "LastStopFlashlight"
	tool.ToolTip = "Flashlight"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 0.5, 2)
	handle.Color = Color3.fromRGB(45, 52, 58)
	handle.Material = Enum.Material.Metal
	handle.Parent = tool
	local beam = Instance.new("SpotLight")
	beam.Name = "Beam"
	beam.Enabled = false
	beam.Angle = 55
	beam.Range = 45
	beam.Brightness = 2
	beam.Color = Color3.fromRGB(210, 245, 255)
	beam.Face = Enum.NormalId.Front
	beam.Parent = handle
	tool.Activated:Connect(function()
		beam.Enabled = not beam.Enabled
	end)
	return tool
end

function InventoryService.new()
	return setmetatable({ _medkits = {} }, InventoryService)
end

function InventoryService:BeginRun(player)
	self._medkits[player] = 1
	player:SetAttribute("LastStopMedkits", 1)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack and not backpack:FindFirstChild("LastStopFlashlight") then
		makeFlashlight().Parent = backpack
	end
end

function InventoryService:UseMedkit(player, allowed)
	if not allowed(player) then
		return false, "Medkits can only be used during a floor."
	end
	if (self._medkits[player] or 0) <= 0 then
		return false, "No medkits remaining."
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or humanoid.Health >= humanoid.MaxHealth then
		return false, "You do not need a medkit yet."
	end
	self._medkits[player] -= 1
	player:SetAttribute("LastStopMedkits", self._medkits[player])
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 35)
	return true, "Medkit used."
end

function InventoryService:EndRun(player)
	self._medkits[player] = nil
	player:SetAttribute("LastStopMedkits", nil)
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		local tool = container and container:FindFirstChild("LastStopFlashlight")
		if tool then
			tool:Destroy()
		end
	end
end

return InventoryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">MatchmakingService</string>
          <string name="Source"><![CDATA[-- Server-local matchmaking for the vertical slice. It supports solo starts and
-- batches up to twelve queued players; cross-server queues belong in Milestone B.
local MatchmakingService = {}
MatchmakingService.__index = MatchmakingService

function MatchmakingService.new(config, canQueue, onStart, onToast)
	return setmetatable({
		_config = config,
		_canQueue = canQueue,
		_onStart = onStart,
		_onToast = onToast,
		_queue = {},
		_queued = {},
		_countdown = nil,
		_running = false,
		_stopped = false,
	}, MatchmakingService)
end

function MatchmakingService:IsQueued(player)
	return self._queued[player] == true
end

function MatchmakingService:RequestJoin(player)
	if self._running then
		return false, "An expedition is already running in this server. Please wait."
	end
	if not self._canQueue(player) then
		return false, "Your profile is still loading."
	end
	if self._queued[player] then
		return true, "Already queued."
	end
	self._queued[player] = true
	table.insert(self._queue, player)
	if not self._countdown then
		self._countdown = self._config.LobbyQueueCountdown
	end
	return true, "Queued for the next elevator."
end

function MatchmakingService:Remove(player)
	self._queued[player] = nil
	for index = #self._queue, 1, -1 do
		if self._queue[index] == player then
			table.remove(self._queue, index)
		end
	end
	if #self._queue == 0 then
		self._countdown = nil
	end
end

function MatchmakingService:_startQueuedGroup()
	if self._running or #self._queue == 0 then
		return
	end
	local group = {}
	while #group < self._config.MaxExpeditionPlayers and #self._queue > 0 do
		local player = table.remove(self._queue, 1)
		self._queued[player] = nil
		if player.Parent and self._canQueue(player) then
			table.insert(group, player)
		end
	end
	self._countdown = #self._queue > 0 and self._config.LobbyQueueCountdown or nil
	if #group > 0 then
		self._running = true
		self._onStart(group, function()
			self._running = false
		end)
	end
end

function MatchmakingService:Start()
	task.spawn(function()
		while not self._stopped do
			task.wait(1)
			if not self._running and self._countdown then
				self._countdown -= 1
				for player in pairs(self._queued) do
					self._onToast(player, "Elevator departs in " .. math.max(0, self._countdown) .. "s")
				end
				if self._countdown <= 0 then
					self:_startQueuedGroup()
				end
			end
		end
	end)
end

function MatchmakingService:Destroy()
	self._stopped = true
end

return MatchmakingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">PbrMaterialService</string>
          <string name="Source"><![CDATA[-- MaterialVariants are authored in default.project.json. BaseMaterial and map
-- properties require Studio/plugin capability and must never be written by a
-- live server script. Runtime only assigns the saved variant to cloned parts.
local MaterialService = game:GetService("MaterialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ArtTheme = require(ReplicatedStorage.Shared.ArtTheme)

local PbrMaterialService = {}

local function validContentId(value)
	return typeof(value) == "string" and value ~= ""
end

local function isComplete(definition)
	return definition
		and validContentId(definition.ColorMap)
		and validContentId(definition.NormalMap)
		and validContentId(definition.RoughnessMap)
		and validContentId(definition.MetalnessMap)
end

function PbrMaterialService:Configure()
	local configured = {}
	for name, definition in pairs(ArtTheme.Pbr) do
		if isComplete(definition) then
			local variant = MaterialService:FindFirstChild(name)
			assert(variant and variant:IsA("MaterialVariant"),
				("[LAST STOP] Missing saved MaterialService.%s; rebuild default.project.json"):format(name))
			-- Map reads are also Plugin-protected. The offline build audit checks IDs.
			configured[name] = true
		end
	end
	return configured
end

function PbrMaterialService:Apply(root)
	local configured = self:Configure()
	if not next(configured) then
		return false
	end

	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local tag = descendant:FindFirstChild("PbrMaterial")
			local materialName = descendant:GetAttribute("PbrMaterial") or (tag and tag.Value)
			local definition = materialName and ArtTheme.Pbr[materialName]
			if definition and configured[materialName] then
				descendant.Material = definition.BaseMaterial
				descendant.MaterialVariant = materialName
			end
		end
	end

	return true
end

return PbrMaterialService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source"><![CDATA[-- Persistent, server-owned player profile service. DataStore failures degrade to a
-- session profile; no client-supplied balance is ever accepted.
local DataStoreService = game:GetService("DataStoreService")

local ProfileService = {}
ProfileService.__index = ProfileService

local function defaultProfile(config)
	return {
		Version = config.Version,
		Coins = config.StarterCoins,
		XP = config.StarterXP,
		Level = 1,
		Equipment = { Flashlight = true, Scanner = true, Medkit = 1 },
		Stats = { Escapes = 0, BestDepth = 0, FirstEscapeClaimed = false },
	}
end

local function normalise(saved, config)
	local profile = defaultProfile(config)
	if type(saved) ~= "table" then
		return profile
	end
	profile.Version = math.max(tonumber(saved.Version) or 1, 1)
	profile.Coins = math.max(0, math.floor(tonumber(saved.Coins) or 0))
	profile.XP = math.max(0, math.floor(tonumber(saved.XP) or 0))
	profile.Level = math.max(1, math.floor(tonumber(saved.Level) or 1))
	if type(saved.Equipment) == "table" then
		profile.Equipment = saved.Equipment
	end
	if type(saved.Stats) == "table" then
		for key, value in pairs(saved.Stats) do
			if type(value) == "boolean" or type(value) == "number" then
				profile.Stats[key] = value
			end
		end
	end
	return profile
end

function ProfileService.new(config)
	local store
	local storeAvailable, storeError = pcall(function()
		store = DataStoreService:GetDataStore(config.ProfileStoreName)
	end)
	if not storeAvailable then
		warn("[ProfileService] DataStore unavailable; using session-only profiles:", storeError)
	end
	return setmetatable({
		_config = config,
		_store = store,
		_storeAvailable = storeAvailable,
		_profiles = {},
		_dirty = {},
	}, ProfileService)
end

function ProfileService:Load(player)
	local key = "p_" .. player.UserId
	local loaded
	local ok, err = self._storeAvailable, "DataStore unavailable"
	if self._storeAvailable then
		ok, err = pcall(function()
			loaded = self._store:GetAsync(key)
		end)
	end
	if not ok then
		warn("[ProfileService] load failed for", player.UserId, err)
	end
	local profile = normalise(loaded, self._config)
	self._profiles[player] = profile
	self._dirty[player] = not ok
	return profile
end

function ProfileService:Get(player)
	return self._profiles[player]
end

function ProfileService:Mutate(player, callback)
	local profile = self._profiles[player]
	if not profile then
		return false, "Profile not loaded"
	end
	callback(profile)
	self._dirty[player] = true
	return true, profile
end

function ProfileService:Save(player)
	local profile = self._profiles[player]
	if not profile or not self._dirty[player] then
		return true
	end
	if not self._storeAvailable then
		return false, "DataStore unavailable"
	end
	local key = "p_" .. player.UserId
	local snapshot = profile
	local ok, err = pcall(function()
		self._store:UpdateAsync(key, function()
			return snapshot
		end)
	end)
	if ok then
		self._dirty[player] = false
	else
		warn("[ProfileService] save failed for", player.UserId, err)
	end
	return ok, err
end

function ProfileService:Release(player)
	self:Save(player)
	self._profiles[player] = nil
	self._dirty[player] = nil
end

function ProfileService:SaveAll()
	for player in pairs(self._profiles) do
		self:Save(player)
	end
end

return ProfileService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="27">
      <Properties>
        <string name="Name">TestRunner</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Runs pure deterministic smoke tests in Studio Play mode. It is deliberately
-- skipped in published servers so it cannot affect live performance.
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end

local spec = require(script.Parent.Tests.VerticalSliceSpec)
local ok, err = pcall(function()
	spec()
	require(script.Parent.Tests.PrefabLifecycleSpec)()
end)
if not ok then
	error("[LAST STOP] Vertical-slice tests failed: " .. tostring(err))
end
print("[LAST STOP] Vertical-slice pure logic tests passed.")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="28">
      <Properties>
        <string name="Name">Tests</string>
      </Properties>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">PrefabLifecycleSpec</string>
          <string name="Source"><![CDATA[-- Studio integration test: real Instances, two clean room cycles and a world
-- rebuild. Sources and sibling authored art must survive every cycle.
return function()
	local storage=game:GetService("ServerStorage")
	local FloorService=require(script.Parent.Parent.Services.FloorService)
	local definition=require(game.ReplicatedStorage.Shared.Config.FloorConfig).Floors[1]
	local assets=storage:WaitForChild("LastStopAssets")
	local before={}
	for _, template in ipairs({assets.Lobby,assets.Elevator,assets.Floors.Hospital,assets.Stalker}) do before[template]=#template:GetDescendants() end
	local world=Instance.new("Folder")
	world.Name="LastStopPrefabLifecycleTest";world.Parent=workspace
	local sentinel=Instance.new("Folder")
	sentinel.Name="AuthoredSiblingMustSurvive";sentinel.Parent=world
	local floors=FloorService.new({WorldName=world.Name,FloorOrigin=Vector3.new(1500,0,700)})
	local ok,err=xpcall(function()
		for run=1,2 do
			local lobby=floors:BuildWorld()
			assert(lobby.Model~=assets.Lobby and lobby.Model:GetAttribute("SourceTemplate"),"Lobby must be a tagged clone")
			assert(lobby.SpawnLocation:IsA("SpawnLocation"),"Engine spawn must target the concourse")
			assert(sentinel.Parent==world,"BuildWorld deleted authored sibling art")
			local room=floors:CreateRoom(definition,run)
			room:Initialize({interactionDistance=12,isPlayerActive=function() return false end,onObjectiveStep=function() error("No simulated players should interact") end})
			room:Start()
			assert(room.model~=assets.Floors.Hospital and room.model:GetAttribute("SourceTemplate"),"Hospital must clone the authored model")
			assert(room.model.Rooms:FindFirstChild("PatientWard") and room.model.Rooms:FindFirstChild("Archive"),"Hospital spaces missing")
			assert(#room.patrolPoints>=5 and room.escapeSize.X==18,"Hospital markers were not bound")
			local progress,total=room:ObjectiveProgress()
			assert(progress==0 and total==3,"A new round must reset objectives")
			local clone=room.model
			room:Cleanup()
			assert(clone.Parent==nil and next(room.targets)==nil,"Round cleanup must remove only the active clone")
			for template,count in pairs(before) do assert(template:IsDescendantOf(storage) and #template:GetDescendants()==count,"Source prefab mutated or deleted") end
		end
	end,debug.traceback)
	world:Destroy()
	assert(ok,err)
	print("[LAST STOP] Prefab lifecycle PASS: two rounds, objective reset, source preservation, authored sibling preservation")
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">TwoPlayerRecoverySpec</string>
          <string name="Source"><![CDATA[-- Explicit opt-in Studio test. Start a 2-player local server, then run from its
-- SERVER command bar: require(game.ServerScriptService.Tests.TwoPlayerRecoverySpec)()
-- Uses real local players and the real state machine; profiles are disposable
-- memory data, so this test never modifies a published player's saved balance.
return function()
	assert(game:GetService("RunService"):IsStudio(),"Studio test only")
	local players=game:GetService("Players"):GetPlayers()
	assert(#players==2,"Start Server & Clients with exactly two players first")
	table.sort(players,function(a,b) return a.UserId<b.UserId end)
	local services=script.Parent.Parent.Services
	local FloorService=require(services.FloorService)
	local Expedition=require(services.ExpeditionService)
	local Inventory=require(services.InventoryService)
	local Enemy=require(services.EnemyService)
	local Economy=require(services.EconomyService)
	local config=table.clone(require(game.ReplicatedStorage.Shared.Config.GameConfig))
	config.BoardingSeconds,config.TravelSeconds,config.EscapeSeconds,config.DecisionSeconds=1,1,12,10
	local memory={data={}}
	for _, player in ipairs(players) do memory.data[player]={Coins=0,XP=0,Level=1,Stats={Runs=0,Escapes=0,BestDepth=0,FirstEscapeClaimed=true}} end
	function memory:Get(player) return self.data[player] end
	function memory:Mutate(player,fn) fn(self.data[player]);return true end
	function memory:Save() return true end
	local floors=FloorService.new()
	floors:BuildWorld()
	local enemies=Enemy.new();enemies:Start()
	local inventory=Inventory.new()
	local economy=Economy.new(memory,config)
	local remotes={}
	for _, r in ipairs(game.ReplicatedStorage.Remotes:GetChildren()) do remotes[r.Name]=r end
	local expedition=Expedition.new(config,floors,enemies,economy,memory,inventory,remotes,function() end)
	local function waitFor(test,label,timeout)
		local deadline=os.clock()+(timeout or 20)
		repeat if test() then return end;task.wait(.1) until os.clock()>deadline
		error("[V3 TWO PLAYER] Timed out: "..label.."; state="..expedition.state)
	end
	local verifiedEnemy=false
	local function recoverRound(active)
		waitFor(function() return expedition.state=="Floor" end,"floor start")
		local room=expedition.floor
		if not verifiedEnemy then
			waitFor(function() return enemies._enemies[1] end,"Stalker spawn",10)
			local stalker=enemies._enemies[1]
			local initial=stalker.root.Position
			waitFor(function() return (stalker.root.Position-initial).Magnitude>2 end,"Stalker physics movement",10)
			local victim=active[1]
			victim.Character:PivotTo(CFrame.new(stalker.root.Position+Vector3.new(0,0,3)))
			local health=victim.Character.Humanoid.Health
			waitFor(function() return victim.Character.Humanoid.Health<health end,"Stalker windup damage",8)
			assert(health-victim.Character.Humanoid.Health==15,"Unexpected Stalker damage")
			victim.Character.Humanoid.Health=100
			victim.Character:PivotTo(room.spawnCFrame)
			verifiedEnemy=true
			print("[V3 TWO PLAYER] Stalker moved physically and dealt 15 damage after windup")
		end
		local keys={};for key in pairs(room.targets) do table.insert(keys,key) end;table.sort(keys)
		-- Check real navigation, rather than accepting proximity-only teleports as
		-- evidence that a wall/door layout is traversable.
		for _, key in ipairs(keys) do
			local target=room.targets[key]
			local path=game:GetService("PathfindingService"):CreatePath({AgentRadius=1.8,AgentHeight=5,AgentCanJump=false})
			for retry=1,5 do
				path:ComputeAsync(room.spawnCFrame.Position,target.Position+Vector3.new(0,0,3))
				if path.Status==Enum.PathStatus.Success then break end
				task.wait(.3) -- allow navigation tiles to rebuild after the last room clone
			end
			assert(path.Status==Enum.PathStatus.Success,"Record route blocked: "..key);path:Destroy()
		end
		local player=active[1]
		for index,key in ipairs(keys) do
			local target=room.targets[key]
			player.Character:PivotTo(CFrame.new(target.Position+Vector3.new(0,2,3)))
			task.wait(.2)
			if index==#keys then task.spawn(function() room:_attemptInteraction(player,key) end)
			else room:_attemptInteraction(player,key);room:_attemptInteraction(player,key) end
			waitFor(function() return target:GetAttribute("Used") end,"record accepted: "..key,2)
		end
		waitFor(function() return expedition.state=="Escape" end,"objective completion")
		assert(select(1,room:ObjectiveProgress())==3,"Duplicate record interaction changed objective count")
		for index,p in ipairs(active) do p.Character:PivotTo(room.escapeCFrame*CFrame.new((index-1)*3,0,0)) end
		waitFor(function() return expedition.state=="Decision" end,"return elevator")
		return room.model
	end
	local ok,err=xpcall(function()
		expedition:Start(players)
		local first=recoverRound(players)
		assert(expedition:RequestDecision(players[1],"Bank"))
		assert(expedition:RequestDecision(players[2],"Continue"))
		waitFor(function() return expedition.depth==2 and expedition.state=="Floor" end,"second round")
		assert(first.Parent==nil,"Previous hospital was not cleaned up")
		assert(economy:GetBankedCoins(players[1])==80 and economy:GetBankedCoins(players[2])==0,"Independent Bank/Continue balance failed")
		assert(expedition.unbanked[players[2]]==80,"Continuer lost at-risk reward")
		assert(not expedition:RequestDecision(players[1],"Bank"),"Banker can claim the same reward twice")
		local second=recoverRound({players[2]})
		assert(expedition:RequestDecision(players[2],"Bank"))
		waitFor(function() return not expedition:IsRunning() end,"final bank")
		assert(economy:GetBankedCoins(players[2])>80 and economy:GetBankedCoins(players[1])==80,"Second round accounting failed")
		assert(second.Parent==nil and game.ServerStorage.LastStopAssets.Floors.Hospital.Parent,"Source/clone lifecycle failed")
		print("[V3 TWO PLAYER] PASS: two real players, three reachable records, duplicate rejection, escape region, independent BANK/CONTINUE, two floor clones, teardown; disposable profiles only")
	end,debug.traceback)
	expedition:Destroy();enemies:Destroy()
	assert(ok,err)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">VerticalSliceSpec</string>
          <string name="Source"><![CDATA[return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local EconomyService = require(script.Parent.Parent.Services.EconomyService)
	local RateLimiter = require(ReplicatedStorage.Shared.Util.RateLimiter)

	local fakeProfiles = {}
	local economy = EconomyService.new(fakeProfiles, { FirstEscapeBonus = 50 })
	local depthOneCoins, depthOneXP = economy:CalculateFloorReward(1, 3)
	assert(depthOneCoins == 80, "Expected 80 coins at depth 1 with three objective steps")
	assert(depthOneXP == 25, "Expected 25 XP at depth 1")
	local depthTenCoins = select(1, economy:CalculateFloorReward(10, 3))
	assert(depthTenCoins > depthOneCoins, "Depth multiplier must increase rewards")

	local limiter = RateLimiter.new(2, 60)
	assert(limiter:Allow("player"), "First request should pass")
	assert(limiter:Allow("player"), "Second request should pass")
	assert(not limiter:Allow("player"), "Third request must be blocked")
	limiter:Forget("player")
	assert(limiter:Allow("player"), "Forget must clear a player's bucket")
end
]]></string>
        </Properties>
      </Item>
    </Item>
